generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  ADMIN
  SUPER_ADMIN
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

model Setting {
  id                  String  @id @default(cuid())
  logoData            String?
  certificateLogoData String?
  collectMoneyTotal   Float   @default(0)

  // Tax Information. taxRegistrationEffectiveDate (NOT taxCertificateIssueDate, NOT
  // "today") is what defines the start of every dynamic Financial Report period --
  // kept as a separate field so the two dates can never be confused in code or UI.
  taxRegistrationNumber        String?
  taxRegistrationEffectiveDate DateTime?
  taxCertificateIssueDate      DateTime?
  firstTaxPeriodStart          DateTime?
  firstTaxPeriodEnd            DateTime?
  firstTaxReturnFilingDueDate  DateTime?

  // Equity inputs with no other source anywhere in the system.
  shareCapital      Float?
  statutoryReserves Float?

  // Authorized Signatory block, shown on every Financial Report export.
  signatoryName        String?
  signatoryDesignation String?

  // Which Employee's wallet position (custody + cash - expenses) represents the
  // Shareholder's Current Account line on the Balance Sheet. Defaults to the sole
  // current Admin until changed.
  shareholderEmployeeId String?
  shareholderEmployee   Employee? @relation("SettingShareholder", fields: [shareholderEmployeeId], references: [id])

  updatedAt DateTime @updatedAt
}

model Team {
  id                   String                @id @default(cuid())
  name                 String                @unique
  employees            Employee[]
  invoices             Invoice[]
  expenses             Expense[]
  workReports          WorkReport[]
  quotations           Quotation[]
  warrantyCertificates WarrantyCertificate[]
  orders               Order[]
}

model Employee {
  id                           String                         @id @default(cuid())
  code                         String                         @unique
  name                         String
  jobTitle                     String
  role                         Role                           @default(EMPLOYEE)
  pinHash                      String
  status                       String                         @default("active")
  phone                        String?
  photoData                    String?
  custody                      Float                          @default(0)
  revenueWithdrawn             Float                          @default(0)
  walletResetAt                DateTime?
  monthlySalary                Float                          @default(0)
  hasWallet                    Boolean                        @default(true)
  canViewCreditCardWallets     Boolean                        @default(false)
  invoicesAccess               String                         @default("No Access")
  expensesAccess               String                         @default("No Access")
  // Which /admin dashboard sections a plain ADMIN can see (Employee.role
  // ADMIN, not SUPER_ADMIN). Empty = unrestricted (sees everything) -- the
  // default, so no existing or newly-created Admin loses access until a
  // Super Admin explicitly narrows this list. Ignored entirely for
  // SUPER_ADMIN, who is always unrestricted. See src/lib/adminSections.ts.
  adminSections                String[]                       @default([])
  // Optional granular permission role for an ADMIN. Null = full admin access, exactly as before, so no
  // existing admin loses anything until a Super Admin assigns a narrower role. SUPER_ADMIN ignores it.
  adminRoleId                  String?
  adminRole                    AdminRole?                     @relation(fields: [adminRoleId], references: [id])
  joinDate                     DateTime?
  endOfServiceDate             DateTime?
  teamId                       String?
  team                         Team?                          @relation(fields: [teamId], references: [id])
  invoices                     Invoice[]
  expenses                     Expense[]
  payrollEntries               PayrollEntry[]                 @relation("PayrollFor")
  payrollEntriesCreated        PayrollEntry[]                 @relation("PayrollCreatedBy")
  workReports                  WorkReport[]
  quotations                   Quotation[]
  warrantyCertificates         WarrantyCertificate[]
  ordersAssigned               Order[]                        @relation("OrderAssignedTo")
  ordersCreated                Order[]                        @relation("OrderCreatedBy")
  ordersDone                   Order[]                        @relation("OrderDoneBy")
  ordersCancelled              Order[]                        @relation("OrderCancelledBy")
  ordersRescheduled            Order[]                        @relation("OrderRescheduledBy")
  orderStatusChanges           OrderStatusChange[]
  invoiceStatusChanges         InvoiceStatusChange[]
  customersCreated             Customer[]                     @relation("CustomerCreatedBy")
  customersUpdated             Customer[]                     @relation("CustomerUpdatedBy")
  blogPostsCreated             BlogPost[]                     @relation("BlogPostCreatedBy")
  blogPostsUpdated             BlogPost[]                     @relation("BlogPostUpdatedBy")
  servicePagesCreated          ServicePage[]                  @relation("ServicePageCreatedBy")
  servicePagesUpdated          ServicePage[]                  @relation("ServicePageUpdatedBy")
  homeSectionsUpdated          HomeSection[]                  @relation("HomeSectionUpdatedBy")
  customerNotesCreated         CustomerNote[]
  creditCardsCreated           CreditCard[]                   @relation("CreditCardCreatedBy")
  creditCardPaymentsRecorded   CreditCardPayment[]            @relation("CreditCardPaymentRecordedBy")
  creditCardAuditLogs          CreditCardAuditLog[]           @relation("CreditCardAuditLogPerformedBy")
  vehiclesCreated              Vehicle[]                      @relation("VehicleCreatedBy")
  vehicleExpensesResponsible   Expense[]                      @relation("ExpenseResponsibleEmployee")
  assetsCreated                Asset[]                        @relation("AssetCreatedBy")
  liabilitiesCreated           Liability[]                    @relation("LiabilityCreatedBy")
  cashPositionUpdates          CashPosition[]                 @relation("CashPositionUpdatedBy")
  settingsAsShareholder        Setting[]                      @relation("SettingShareholder")
  rentalAgreementsCreated      RentalAgreement[]              @relation("RentalAgreementCreatedBy")
  inventoryItemsCreated        InventoryItem[]                @relation("InventoryItemCreatedBy")
  inventoryTransactionsCreated InventoryTransaction[]         @relation("InventoryTransactionCreatedBy")
  inventoryRequirements        EmployeeInventoryRequirement[] @relation("InventoryRequirementFor")
  inventoryRequirementsCreated EmployeeInventoryRequirement[] @relation("InventoryRequirementCreatedBy")
  inventoryUsages              InvoiceInventoryUsage[]
  suppliersCreated             Supplier[]                     @relation("SupplierCreatedBy")
  labourItemsCreated           LabourItem[]                   @relation("LabourItemCreatedBy")
  inventoryCategoriesCreated   InventoryCategory[]            @relation("InventoryCategoryCreatedBy")
  stockRequestsSubmitted       StockRequest[]                 @relation("StockRequestBy")
  stockRequestsDecided         StockRequest[]                 @relation("StockRequestDecidedBy")
  stockReturnRequestsSubmitted StockReturnRequest[]           @relation("StockReturnRequestBy")
  stockReturnRequestsDecided   StockReturnRequest[]           @relation("StockReturnRequestDecidedBy")
  sparePartPriceModification   String                         @default("Not Allowed")
  sparePartMaxDiscountPercent  Float?
  labourPriceModification      String                         @default("Not Allowed")
  labourMaxDiscountPercent     Float?
  createdAt                    DateTime                       @default(now())
}

model Customer {
  id               String            @id @default(cuid())
  code             String            @unique
  type             CustomerType      @default(INDIVIDUAL)
  name             String
  companyName      String?
  trn              String?
  phone            String            @unique
  whatsapp         String?
  email            String?           @unique
  passwordHash     String?
  language         String            @default("Arabic")
  emirate          String
  city             String?
  area             String?
  buildingType     String?
  buildingName     String?
  flatNo           String?
  address          String?
  locationUrl      String?
  notes            String?
  status           String            @default("Active")
  // First-touch attribution: how this customer originally found OSTA. Set once at
  // creation (by whichever flow -- Add Customer, New Order, or New Invoice -- created
  // the record) and not overwritten afterward, unlike Invoice.leadSource which is
  // chosen per-invoice and drives the Marketing dashboard's revenue attribution.
  leadSource       String            @default("Organic")
  createdById      String?
  createdBy        Employee?         @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  updatedById      String?
  updatedBy        Employee?         @relation("CustomerUpdatedBy", fields: [updatedById], references: [id])
  updatedAt        DateTime          @default(now()) @updatedAt
  invoices         Invoice[]
  orders           Order[]
  quotations       Quotation[]
  customerNotes    CustomerNote[]
  rentalAgreements RentalAgreement[]
  createdAt        DateTime          @default(now())
}

model CustomerNote {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  note        String
  createdById String
  createdBy   Employee @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// A second, independent financial relationship a Customer can have with OSTA --
// OSTA renting accommodation/office/etc. FROM that customer. Deliberately kept
// entirely separate from Invoice/Order revenue and Accounts Receivable (see
// RentalTransaction below) so the two flows -- Customer -> OSTA revenue, and
// OSTA -> Customer rent expense -- never net against each other.
model RentalAgreement {
  id               String              @id @default(cuid())
  customerId       String
  customer         Customer            @relation(fields: [customerId], references: [id])
  agreementName    String
  rentalType       String // Accommodation | Office | Warehouse | Shop | Staff Accommodation | Other
  monthlyRent      Float
  paymentFrequency String              @default("Monthly") // Monthly | Quarterly | Semi-Annual | Annual | Custom
  startDate        DateTime
  endDate          DateTime?
  paymentDueDay    Int                 @default(1) // 1-31
  paymentMethod    String              @default("Bank Transfer")
  notes            String?
  status           String              @default("Active") // Active | Suspended | Expired | Cancelled
  createdById      String
  createdBy        Employee            @relation("RentalAgreementCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime            @default(now())
  transactions     RentalTransaction[]
}

// One row per billing period, mirroring VehicleFineInstallment's expenseId-pairing
// pattern. The @@unique constraint is what structurally guarantees "do not create
// duplicate transactions if the monthly transaction already exists" -- generation
// pre-queries existing periods, and this is the hard backstop against races.
model RentalTransaction {
  id                String          @id @default(cuid())
  rentalAgreementId String
  rentalAgreement   RentalAgreement @relation(fields: [rentalAgreementId], references: [id], onDelete: Cascade)
  billingPeriod     DateTime // first-of-month marker for the period this covers
  dueDate           DateTime
  amount            Float
  paymentStatus     String          @default("Pending") // Pending | Due | Overdue | Paid | Cancelled
  paymentDate       DateTime?
  paymentMethod     String?
  referenceNumber   String?
  notes             String?
  expenseId         String?         @unique
  expense           Expense?        @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())

  @@unique([rentalAgreementId, billingPeriod])
}

model Invoice {
  id                    String                  @id @default(cuid())
  number                String                  @unique
  date                  DateTime
  customerId            String
  customer              Customer                @relation(fields: [customerId], references: [id])
  serviceType           String                  @default("Repair")
  category              String                  @default("AC")
  payment               String
  amount                Float
  status                String                  @default("Unpaid")
  paymentLink           String?
  refundedAmount        Float                   @default(0)
  leadSource            String                  @default("Organic")
  warrantyUntil         DateTime?
  teamId                String?
  team                  Team?                   @relation(fields: [teamId], references: [id])
  createdById           String
  createdBy             Employee                @relation(fields: [createdById], references: [id])
  items                 InvoiceItem[]
  statusChanges         InvoiceStatusChange[]
  order                 Order?
  quotation             Quotation?
  inventoryTransactions InventoryTransaction[]
  inventoryUsages       InvoiceInventoryUsage[]
  createdAt             DateTime                @default(now())
}

model InvoiceStatusChange {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  previousStatus String
  newStatus      String
  changedById    String
  changedBy      Employee @relation(fields: [changedById], references: [id])
  createdAt      DateTime @default(now())
}

model InvoiceItem {
  id              String         @id @default(cuid())
  invoiceId       String
  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceName     String
  description     String?
  qty             Int            @default(1)
  unitPrice       Float
  // Spare Parts Catalog additions -- all additive/nullable. itemType defaults
  // to "Service" so every existing row and code path keeps working unchanged.
  // unitPrice keeps meaning "final, actually-charged price"; originalPrice is
  // only set for SparePart/Labour lines (the catalog price at add-time).
  itemType        String         @default("Service") // "Service" | "SparePart" | "Labour"
  originalPrice   Float?
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  labourItemId    String?
  labourItem      LabourItem?    @relation(fields: [labourItemId], references: [id])
}

model Order {
  id               String    @id @default(cuid())
  number           String    @unique
  date             DateTime  @default(now())
  scheduledAt      DateTime?
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id])
  locationUrl      String?
  orderType        String    @default("New Order")
  priceAgreed      String    @default("No")
  customerLanguage String    @default("Arabic")
  leadSource       String    @default("Organic")
  notes            String?
  status           String    @default("Assigned")
  teamId           String?
  team             Team?     @relation(fields: [teamId], references: [id])
  // Nullable to support customer self-service booking via the API (status "Requested"),
  // which has no employee assigned or creating it yet -- an admin triages it via the
  // Edit Order form, which assigns both and flips status to "Assigned".
  assignedToId     String?
  assignedTo       Employee? @relation("OrderAssignedTo", fields: [assignedToId], references: [id])
  createdById      String?
  createdBy        Employee? @relation("OrderCreatedBy", fields: [createdById], references: [id])
  invoiceId        String?   @unique
  invoice          Invoice?  @relation(fields: [invoiceId], references: [id])

  acceptedAt    DateTime?
  departedAt    DateTime?
  etaMinutes    String?
  arrivedAt     DateTime?
  arrivalGpsLat Float?
  arrivalGpsLng Float?
  workStartedAt DateTime?
  jobNotes      String?

  photos OrderPhoto[]

  // Dynamic pricing (all nullable so every pre-existing order stays valid). Money is
  // integer fils. pricingSnapshot is the full immutable quote JSON taken at creation.
  regionId          String?
  region            Region?          @relation(fields: [regionId], references: [id])
  bookableServiceId String?
  bookableService   BookableService? @relation(fields: [bookableServiceId], references: [id])
  bookingTypeId     String?
  bookingType       BookingType?     @relation(fields: [bookingTypeId], references: [id])
  quantity          Int?
  totalFils         Int?
  pricingSnapshot   Json?
  visitFeePolicyId  String?
  visitFeePolicy    VisitFeePolicy?  @relation(fields: [visitFeePolicyId], references: [id])
  consentAcceptedAt DateTime?
  idempotencyKey    String?          @unique
  events            OrderEvent[]
  visitFeeCharges   VisitFeeCharge[]

  // Admin-only status overrides (Done / Cancelled / Reschedule) -- see OrderStatusChange
  // for the full audit trail, including the before/after appointment on each reschedule.
  doneAt             DateTime?
  doneById           String?
  doneBy             Employee?           @relation("OrderDoneBy", fields: [doneById], references: [id])
  cancelledAt        DateTime?
  cancelledById      String?
  cancelledBy        Employee?           @relation("OrderCancelledBy", fields: [cancelledById], references: [id])
  cancellationReason String?
  rescheduledAt      DateTime?
  rescheduledById    String?
  rescheduledBy      Employee?           @relation("OrderRescheduledBy", fields: [rescheduledById], references: [id])
  rescheduleReason   String?
  statusChanges      OrderStatusChange[]

  createdAt DateTime @default(now())
}

model OrderStatusChange {
  id                  String    @id @default(cuid())
  orderId             String
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousStatus      String
  newStatus           String
  reason              String?
  // Only set on Reschedule changes -- preserves the appointment that was in effect
  // right before this change, so a chain of reschedules stays fully reconstructable.
  previousScheduledAt DateTime?
  newScheduledAt      DateTime?
  changedById         String
  changedBy           Employee  @relation(fields: [changedById], references: [id])
  createdAt           DateTime  @default(now())
}

model OrderPhoto {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      String
  dataUrl   String
  createdAt DateTime @default(now())
}

model Expense {
  id                    String                   @id @default(cuid())
  number                String?                  @unique
  date                  DateTime
  description           String
  vendor                String?
  referenceNumber       String?
  notes                 String?
  category              String?
  vehicle               String?
  subcategory           String?
  payment               String                   @default("Cash")
  amount                Float
  status                String                   @default("Recorded")
  refundedAmount        Float                    @default(0)
  attachmentUrl         String?
  teamId                String?
  team                  Team?                    @relation(fields: [teamId], references: [id])
  creditCardId          String?
  creditCard            CreditCard?              @relation(fields: [creditCardId], references: [id])
  // Vehicle Management System fields -- vehicle is left as the legacy free-text
  // label (only ever read for the one-time historical backfill / display fallback);
  // new Vehicle-category expenses only ever set vehicleId going forward.
  vehicleId             String?
  vehicleRef            Vehicle?                 @relation("ExpenseVehicle", fields: [vehicleId], references: [id])
  odometer              Int?
  // Second-level type within a Vehicle expense's subcategory: Service Type when
  // subcategory=Service, Fuel Type when subcategory="Petrol / Fuel", Fine Type
  // when subcategory=Fine -- reuses one column the same way `subcategory` already
  // serves both Vehicle and Advertising categories.
  detailType            String?
  liters                Float?
  responsibleEmployeeId String?
  responsibleEmployee   Employee?                @relation("ExpenseResponsibleEmployee", fields: [responsibleEmployeeId], references: [id])
  companyAmount         Float? // Fine only
  employeeAmount        Float? // Fine only
  nextServiceInterval   Int? // Service only, in KM
  fineInstallments      VehicleFineInstallment[]
  rentalTransaction     RentalTransaction?
  createdById           String
  createdBy             Employee                 @relation(fields: [createdById], references: [id])
  createdAt             DateTime                 @default(now())
}

// One card = one independent wallet: its own limit, expenses, payments, statement.
// Only the last 4 digits of the card number are ever persisted -- the full number
// is never sent to the server or stored, since this app never needs to redisplay
// or reuse it (avoids taking on PCI-DSS scope for zero functional benefit).
model CreditCard {
  id             String               @id @default(cuid())
  name           String
  cardHolder     String?
  lastFour       String
  creditLimit    Float                @default(0)
  billingCycle   String?
  paymentDueDate Int?
  status         String               @default("Active")
  notes          String?
  expenses       Expense[]
  payments       CreditCardPayment[]
  auditLogs      CreditCardAuditLog[]
  createdById    String
  createdBy      Employee             @relation("CreditCardCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime             @default(now())
}

// Settlement/payment against a card's outstanding balance -- deliberately never
// creates or touches an Expense row, so a payment can never double-count as spend.
model CreditCardPayment {
  id              String     @id @default(cuid())
  creditCardId    String
  creditCard      CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  date            DateTime
  amount          Float
  paymentMethod   String
  bankAccount     String?
  referenceNumber String?
  notes           String?
  recordedById    String
  recordedBy      Employee   @relation("CreditCardPaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt       DateTime   @default(now())
}

model CreditCardAuditLog {
  id            String     @id @default(cuid())
  creditCardId  String
  creditCard    CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  action        String
  description   String
  oldValue      String?
  newValue      String?
  performedById String
  performedBy   Employee   @relation("CreditCardAuditLogPerformedBy", fields: [performedById], references: [id])
  createdAt     DateTime   @default(now())
}

// Admin-added expense categories on top of the hardcoded EXPENSE_CATEGORIES list
// in src/lib/expenseData.ts -- additive only (no edit/delete in this pass).
model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// Current odometer and next-service-due are deliberately NOT stored here -- both
// are computed on the fly from Expense rows (src/lib/vehicleData.ts), mirroring
// how getCreditCardWalletSummary never denormalizes a running balance onto
// CreditCard. initialOdometer is the one stored baseline, used only when a
// vehicle has zero odometer-bearing Expense rows yet.
model Vehicle {
  id                 String    @id @default(cuid())
  name               String    @unique // must match historical Expense.vehicle strings for backfill
  owner              String?
  plateType          String?
  plateNumber        String?
  licensingAuthority String?
  trafficCode        String?
  licenseExpiry      DateTime?
  insuranceExpiry    DateTime?
  policyNumber       String?
  insuranceCompany   String?
  insuranceType      String?
  year               Int?
  chassisNumber      String?
  initialOdometer    Int       @default(0)
  registrationDocUrl String?
  insuranceDocUrl    String?
  status             String    @default("Active") // "Active" | "Inactive"
  notes              String?
  expenses           Expense[] @relation("ExpenseVehicle")
  createdById        String
  createdBy          Employee  @relation("VehicleCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime  @default(now())
}

// One row per fine-deduction installment, created upfront (all N at once,
// atomically with Expense.create) at fine-save time -- never lazily
// materialized. Remembers which PayrollEntry belongs to which fine / which
// installment-of-N so the Fines tab can render "2 of 3 deducted" without
// string-matching PayrollEntry.note. onDelete: Cascade on payrollEntry means
// deleting a Deduction row from the existing Payroll page automatically keeps
// this table's counts (and therefore the derived fine status) accurate.
model VehicleFineInstallment {
  id             String       @id @default(cuid())
  expenseId      String
  expense        Expense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  installmentNo  Int // 1-based, 1..totalCount
  totalCount     Int // N -- 1 for "One Time"
  amount         Float
  month          DateTime // first-of-month marker, mirrors the linked PayrollEntry's date
  payrollEntryId String       @unique
  payrollEntry   PayrollEntry @relation(fields: [payrollEntryId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

// Property, Plant & Equipment register for the Balance Sheet's Non-Current Assets
// line. No accumulatedDepreciation column -- depreciation is computed at query
// time in financialReportsBalanceSheet.ts (straight-line), mirroring the
// established "never denormalize a computed running value" convention already
// used by CreditCard.outstanding and the Vehicle odometer.
model Asset {
  id                 String   @id @default(cuid())
  name               String
  category           String // "Vehicle" | "Equipment" | "Furniture" | "Tools" | "Property" | "Other"
  purchaseCost       Float
  purchaseDate       DateTime
  usefulLifeYears    Int
  depreciationMethod String   @default("Straight-Line")
  notes              String?
  createdById        String
  createdBy          Employee @relation("AssetCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime @default(now())
}

// Register of liabilities with no other derivable source (bank loans, other
// longer-term obligations). Deliberately excludes: credit-card balances (live
// from CreditCard/CreditCardPayment) and Accounts Payable (structurally always 0
// -- no vendor-bill workflow exists in this business).
model Liability {
  id          String   @id @default(cuid())
  name        String
  type        String // "Bank Borrowing" | "Other"
  category    String // "Current" | "Non-Current"
  amount      Float
  notes       String?
  createdById String
  createdBy   Employee @relation("LiabilityCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// Admin-entered opening cash balance as of a chosen date -- the ERP has never
// tracked a running cash balance before now, so there's no way to derive this
// from existing data. Every subsequent cash-like transaction is netted forward
// from here at query time (financialReportsBalanceSheet.ts); this row is never
// itself rewritten by report computation, only by an explicit admin edit.
model CashPosition {
  id             String    @id @default(cuid())
  openingBalance Float     @default(0)
  openingDate    DateTime?
  updatedById    String?
  updatedBy      Employee? @relation("CashPositionUpdatedBy", fields: [updatedById], references: [id])
  updatedAt      DateTime  @updatedAt
}

model WorkReport {
  id            String           @id @default(cuid())
  date          DateTime
  customerName  String?
  customerPhone String?
  emirate       String?
  buildingName  String?
  flatNo        String?
  teamId        String?
  team          Team?            @relation(fields: [teamId], references: [id])
  createdById   String
  createdBy     Employee         @relation(fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())
  items         WorkReportItem[]
}

model WorkReportItem {
  id          String            @id @default(cuid())
  reportId    String
  report      WorkReport        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  deviceType  String
  tonnage     String?
  gasType     String?
  brand       String?
  condition   String
  description String?
  photos      WorkReportPhoto[]
}

model WorkReportPhoto {
  id      String         @id @default(cuid())
  itemId  String
  item    WorkReportItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  dataUrl String
}

model Quotation {
  id           String          @id @default(cuid())
  number       String          @unique
  date         DateTime
  customerType CustomerType    @default(INDIVIDUAL)
  customerName String
  companyName  String?
  trn          String?
  phone        String?
  emirate      String?
  buildingName String?
  flatNo       String?
  customerId   String?
  customer     Customer?       @relation(fields: [customerId], references: [id])
  teamId       String?
  team         Team?           @relation(fields: [teamId], references: [id])
  createdById  String
  createdBy    Employee        @relation(fields: [createdById], references: [id])
  items        QuotationItem[]
  invoiceId    String?         @unique
  invoice      Invoice?        @relation(fields: [invoiceId], references: [id])
  createdAt    DateTime        @default(now())
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  serviceName String
  description String?
  qty         Int       @default(1)
  unitPrice   Float
}

model WarrantyCertificate {
  id                String   @id @default(cuid())
  date              DateTime
  customerName      String
  emirate           String?
  phone             String?
  address           String?
  serviceProvided   String
  equipmentLocation String?
  warrantyFrom      DateTime
  warrantyTo        DateTime
  teamSupervisor    String?
  teamId            String?
  team              Team?    @relation(fields: [teamId], references: [id])
  createdById       String
  createdBy         Employee @relation(fields: [createdById], references: [id])
  createdAt         DateTime @default(now())
}

model PayrollEntry {
  id                     String                  @id @default(cuid())
  employeeId             String
  employee               Employee                @relation("PayrollFor", fields: [employeeId], references: [id])
  type                   String
  amount                 Float
  date                   DateTime
  note                   String?
  createdById            String
  createdBy              Employee                @relation("PayrollCreatedBy", fields: [createdById], references: [id])
  createdAt              DateTime                @default(now())
  vehicleFineInstallment VehicleFineInstallment?
}

model InventoryItem {
  id               String                         @id @default(cuid())
  name             String
  specification    String?
  unit             String
  category         String
  description      String?
  costPrice        Float?
  sellingPrice     Float?
  minimumMainStock Float                          @default(0)
  status           String                         @default("Active")
  // Spare Parts Catalog additions -- all nullable, not backfilled. Existing
  // rows (gas items, base Inventory test items) simply show blank for these.
  sku              String?                        @unique
  nameAr           String?
  subcategory      String?
  brand            String?
  model            String?
  compatibleType   String?
  maximumStock     Float?
  supplierId       String?
  supplier         Supplier?                      @relation(fields: [supplierId], references: [id])
  location         String? // shelf/bin text
  // Warehouse Hierarchy & Governance additions -- nullable, not backfilled.
  barcode          String?                        @unique
  transactions     InventoryTransaction[]
  requirements     EmployeeInventoryRequirement[]
  invoiceUsages    InvoiceInventoryUsage[]
  invoiceItems     InvoiceItem[]
  stockRequests    StockRequest[]
  returnRequests   StockReturnRequest[]
  createdById      String
  createdBy        Employee                       @relation("InventoryItemCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime                       @default(now())
}

// type distinguishes the one company-wide Main Warehouse (where real
// Purchase/Stock-Received events land) from every Branch Warehouse (which
// only ever receives via a Warehouse Transfer from Main). Existing rows
// default to "Branch" -- see scripts/seedWarehouseHierarchyAndCategories.ts
// for the one-time Main Warehouse seed.
model Warehouse {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String   @default("Branch") // "Main" | "Branch"
  status    String   @default("Active")
  createdAt DateTime @default(now())
}

// Admin-editable registry (Add/Edit/Deactivate) replacing the old hardcoded
// INVENTORY_CATEGORIES array. InventoryItem.category/.subcategory stay plain
// strings (unchanged) -- renaming a category cascades that string across
// every InventoryItem row in one transaction rather than via a foreign key.
model InventoryCategory {
  id            String                 @id @default(cuid())
  name          String                 @unique
  nameAr        String?
  status        String                 @default("Active")
  subcategories InventorySubcategory[]
  createdById   String
  createdBy     Employee               @relation("InventoryCategoryCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime               @default(now())
}

model InventorySubcategory {
  id         String            @id @default(cuid())
  categoryId String
  category   InventoryCategory @relation(fields: [categoryId], references: [id])
  name       String
  status     String            @default("Active")
  createdAt  DateTime          @default(now())

  @@unique([categoryId, name])
}

// Employee-initiated; Admin decides. Never a second balance source -- only
// Approved/PartiallyApproved rows trigger a real distributeStock() call in
// src/lib/inventoryData.ts. Pending/Rejected rows are pure workflow state.
model StockRequest {
  id                String        @id @default(cuid())
  employeeId        String
  employee          Employee      @relation("StockRequestBy", fields: [employeeId], references: [id])
  inventoryItemId   String
  inventoryItem     InventoryItem @relation(fields: [inventoryItemId], references: [id])
  requestedQuantity Float
  approvedQuantity  Float?
  reason            String?
  status            String        @default("Pending") // Pending | Approved | PartiallyApproved | Rejected
  sourceWarehouseId String? // set at decision time
  decidedById       String?
  decidedBy         Employee?     @relation("StockRequestDecidedBy", fields: [decidedById], references: [id])
  decidedAt         DateTime?
  createdAt         DateTime      @default(now())
}

// Employee-initiated return; Admin decides. Only an Approved row triggers a
// real returnToWarehouse() call.
model StockReturnRequest {
  id                     String        @id @default(cuid())
  employeeId             String
  employee               Employee      @relation("StockReturnRequestBy", fields: [employeeId], references: [id])
  inventoryItemId        String
  inventoryItem          InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantity               Float
  reason                 String // "Not Used" | "Wrong Part" | "Extra Stock" | "Other"
  status                 String        @default("Pending") // Pending | Approved | Rejected
  destinationWarehouseId String?
  decidedById            String?
  decidedBy              Employee?     @relation("StockReturnRequestDecidedBy", fields: [decidedById], references: [id])
  decidedAt              DateTime?
  createdAt              DateTime      @default(now())
}

model Supplier {
  id            String          @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  notes         String?
  status        String          @default("Active")
  items         InventoryItem[]
  createdById   String
  createdBy     Employee        @relation("SupplierCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
}

// Deliberately NOT an InventoryItem -- no stock, no InventoryTransaction, per
// spec Rule "these are NOT Inventory Items".
model LabourItem {
  id           String        @id @default(cuid())
  code         String        @unique
  nameAr       String
  nameEn       String
  defaultPrice Float
  status       String        @default("Active")
  invoiceItems InvoiceItem[]
  createdById  String
  createdBy    Employee      @relation("LabourItemCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime      @default(now())
}

// The sole source of truth for every stock movement. Current quantity at any
// location is ALWAYS derived -- SUM(quantity WHERE toLocation=X) minus
// SUM(quantity WHERE fromLocation=X) -- never stored on InventoryItem/Employee,
// mirroring how CreditCard.outstanding and vehicle odometer are computed on the
// fly elsewhere. fromLocation/toLocation are plain strings (not real FKs)
// holding "MAIN", an Employee.id, or null (external: a supplier on receipt, or
// consumed/damaged/lost/reversed on the way out) -- a relation can't
// conditionally point at a sentinel string or a real row.
model InventoryTransaction {
  id              String                 @id @default(cuid())
  number          String?                @unique
  inventoryItemId String
  inventoryItem   InventoryItem          @relation(fields: [inventoryItemId], references: [id])
  type            String
  quantity        Float
  fromLocation    String?
  toLocation      String?
  invoiceId       String?
  invoice         Invoice?               @relation(fields: [invoiceId], references: [id])
  reason          String?
  notes           String?
  createdById     String
  createdBy       Employee               @relation("InventoryTransactionCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime               @default(now())
  invoiceUsage    InvoiceInventoryUsage?
}

model EmployeeInventoryRequirement {
  id               String        @id @default(cuid())
  employeeId       String
  employee         Employee      @relation("InventoryRequirementFor", fields: [employeeId], references: [id])
  inventoryItemId  String
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id])
  requiredQuantity Float
  minimumQuantity  Float
  maximumQuantity  Float?
  createdById      String
  createdBy        Employee      @relation("InventoryRequirementCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([employeeId, inventoryItemId])
}

// Join/traceability row, mirroring VehicleFineInstallment's expenseId-pairing
// pattern: one row per {invoice, item}, pointing at the one "Stock Used"
// InventoryTransaction it created. Reversed (a new "Stock Reversed"
// transaction, never a silent delete) on invoice edit/delete.
model InvoiceInventoryUsage {
  id              String               @id @default(cuid())
  invoiceId       String
  invoice         Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem        @relation(fields: [inventoryItemId], references: [id])
  employeeId      String
  employee        Employee             @relation(fields: [employeeId], references: [id])
  quantity        Float
  transactionId   String               @unique
  transaction     InventoryTransaction @relation(fields: [transactionId], references: [id])
  createdAt       DateTime             @default(now())

  @@unique([invoiceId, inventoryItemId])
}

// Public marketing-site content, managed from /admin and served to the public
// website (ostaservices.com / the Next.js marketing app) via GET /api/v1/blog.
// Bilingual fields are flat En/Ar pairs rather than a JSON blob, matching this
// schema's existing convention of flat columns over nested structures.
model BlogPost {
  id               String    @id @default(cuid())
  slug             String    @unique
  titleEn          String
  titleAr          String
  excerptEn        String
  excerptAr        String
  contentEn        String
  contentAr        String
  coverImageUrl    String?
  seoTitleEn       String?
  seoTitleAr       String?
  seoDescriptionEn String?
  seoDescriptionAr String?
  authorName       String?
  published        Boolean   @default(false)
  publishedAt      DateTime?
  createdById      String?
  createdBy        Employee? @relation("BlogPostCreatedBy", fields: [createdById], references: [id])
  updatedById      String?
  updatedBy        Employee? @relation("BlogPostUpdatedBy", fields: [updatedById], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@index([published, publishedAt])
}

// Public marketing-site service pages (e.g. "AC Repair", "Duct Cleaning"), each
// with its own slug/content/price, served via GET /api/v1/services. Separate from
// the internal order-booking category list (osta-bookig-users' hardcoded SERVICES
// array) -- this model is purely marketing content, not tied to order creation.
model ServicePage {
  id                 String    @id @default(cuid())
  slug               String    @unique
  nameEn             String
  nameAr             String
  shortDescriptionEn String
  shortDescriptionAr String
  contentEn          String
  contentAr          String
  iconName           String?
  coverImageUrl      String?
  priceFrom          Float?
  priceNote          String?
  seoTitleEn         String?
  seoTitleAr         String?
  seoDescriptionEn   String?
  seoDescriptionAr   String?
  displayOrder       Int       @default(0)
  published          Boolean   @default(true)
  createdById        String?
  createdBy          Employee? @relation("ServicePageCreatedBy", fields: [createdById], references: [id])
  updatedById        String?
  updatedBy          Employee? @relation("ServicePageUpdatedBy", fields: [updatedById], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  @@index([published, displayOrder])
}

// Generic, reusable content block for the marketing homepage's named sections
// (hero, sustainability, booking, why-choose-ajman, why-choose, areas-we-cover,
// brands-we-service, prime-membership, achievements -- see HOME_SECTION_KEYS in
// the admin). One row per section slot; `key` is a fixed set defined in code, not
// admin-creatable, but every other field (heading/description/image/items) is
// fully admin-editable via /admin/home-sections. `enabled` lets an admin hide a
// whole section from the live site without deleting its content.
model HomeSection {
  id            String            @id @default(cuid())
  key           String            @unique
  headingEn     String
  headingAr     String
  descriptionEn String?
  descriptionAr String?
  imageUrl      String?
  ctaLabelEn    String?
  ctaLabelAr    String?
  ctaUrl        String?
  enabled       Boolean           @default(true)
  displayOrder  Int               @default(0)
  items         HomeSectionItem[]
  updatedById   String?
  updatedBy     Employee?         @relation("HomeSectionUpdatedBy", fields: [updatedById], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt
}

// Repeating entries within a HomeSection -- a trust/feature card, a covered area,
// a serviced brand logo, an achievement, a Prime membership perk, etc. depending
// on which section it belongs to. Admin can add, edit, and delete these freely.
model HomeSectionItem {
  id            String      @id @default(cuid())
  sectionId     String
  section       HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  titleEn       String
  titleAr       String
  descriptionEn String?
  descriptionAr String?
  iconName      String?
  imageUrl      String?
  linkUrl       String?
  displayOrder  Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([sectionId, displayOrder])
}

// ===== Dynamic pricing =====

model Region {
  id           String                   @id @default(cuid())
  serviceAreas ServiceArea[]
  slug         String                   @unique
  nameEn       String
  nameAr       String
  active       Boolean                  @default(true)
  sortOrder    Int                      @default(0)
  prices       ServicePrice[]
  addOnPrices  AddOnPrice[]
  feeOverrides BookingTypeFeeOverride[]
  orders       Order[]
}

model BookableService {
  id                String                   @id @default(cuid())
  serviceAreas      ServiceArea[]            @relation("AreaServices")
  slug              String                   @unique
  nameEn            String
  nameAr            String
  descriptionEn     String?
  descriptionAr     String?
  imageUrl          String?
  pricingUnit       String                   @default("UNIT") // AC_UNIT | UNIT | ROOM | AREA_SQM | VISIT | FIXED
  minQuantity       Int                      @default(1)
  active            Boolean                  @default(true)
  sortOrder         Int                      @default(0)
  pricesIncludeVat  Boolean? // null = use global TaxSetting
  discountRuleSetId String?
  discountRuleSet   DiscountRuleSet?         @relation(fields: [discountRuleSetId], references: [id])
  prices            ServicePrice[]
  addOns            AddOn[]
  feeOverrides      BookingTypeFeeOverride[]
  orders            Order[]
}

// A service is bookable in a region only if an active row exists here.
model ServicePrice {
  id            String          @id @default(cuid())
  serviceId     String
  service       BookableService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  regionId      String
  region        Region          @relation(fields: [regionId], references: [id], onDelete: Cascade)
  unitPriceFils Int
  active        Boolean         @default(true)
  updatedAt     DateTime        @default(now()) @updatedAt

  @@unique([serviceId, regionId])
}

model AddOn {
  id        String          @id @default(cuid())
  serviceId String
  service   BookableService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  nameEn    String
  nameAr    String
  active    Boolean         @default(true)
  prices    AddOnPrice[]
}

model AddOnPrice {
  id        String  @id @default(cuid())
  addOnId   String
  addOn     AddOn   @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  regionId  String
  region    Region  @relation(fields: [regionId], references: [id], onDelete: Cascade)
  priceFils Int
  active    Boolean @default(true)

  @@unique([addOnId, regionId])
}

model BookingType {
  id             String                   @id @default(cuid())
  code           String                   @unique // STANDARD | PRIORITY | EMERGENCY
  nameEn         String
  nameAr         String
  descriptionEn  String?
  descriptionAr  String?
  defaultFeeFils Int                      @default(0)
  hoursStart     String? // "08:00"
  hoursEnd       String? // "22:00"
  sameDayAllowed Boolean                  @default(false)
  active         Boolean                  @default(true)
  sortOrder      Int                      @default(0)
  overrides      BookingTypeFeeOverride[]
  orders         Order[]
}

model BookingTypeFeeOverride {
  id            String           @id @default(cuid())
  bookingTypeId String
  bookingType   BookingType      @relation(fields: [bookingTypeId], references: [id], onDelete: Cascade)
  serviceId     String?
  service       BookableService? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  regionId      String?
  region        Region?          @relation(fields: [regionId], references: [id], onDelete: Cascade)
  feeFils       Int
}

model DiscountRuleSet {
  id       String            @id @default(cuid())
  name     String
  active   Boolean           @default(true)
  startsAt DateTime?
  endsAt   DateTime?
  tiers    DiscountTier[]
  services BookableService[]
}

model DiscountTier {
  id        String          @id @default(cuid())
  ruleSetId String
  ruleSet   DiscountRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  minQty    Int
  maxQty    Int? // null = open-ended
  percent   Float
  startsAt  DateTime?
  endsAt    DateTime?

  @@index([ruleSetId, minQty])
}

// Single-row settings table (id = "default").
model TaxSetting {
  id               String   @id @default("default")
  vatRatePercent   Float    @default(5)
  pricesIncludeVat Boolean  @default(true)
  updatedAt        DateTime @default(now()) @updatedAt
}

// Versioned and immutable: every edit inserts a new row; orders point at the version accepted.
model VisitFeePolicy {
  id                  String           @id @default(cuid())
  version             Int              @unique
  amountFils          Int              @default(10000)
  textAr              String
  textEn              String
  consentLabelAr      String
  consentLabelEn      String
  reasons             String[] // e.g. CUSTOMER_REFUSED, UNREACHABLE, CANCELLED_AFTER_DISPATCH
  requiresAdminReview Boolean          @default(true)
  createdById         String?
  createdAt           DateTime         @default(now())
  orders              Order[]
  charges             VisitFeeCharge[]
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // CREATED | CONFIRMED | DISPATCHED | ARRIVED | COMPLETED | CANCELLED_BY_CUSTOMER | CANCELLED_BY_COMPANY | NO_ANSWER
  note      String?
  actorId   String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model VisitFeeCharge {
  id           String         @id @default(cuid())
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  policyId     String
  policy       VisitFeePolicy @relation(fields: [policyId], references: [id])
  reason       String
  evidence     String?
  status       String         @default("PENDING_REVIEW") // PENDING_REVIEW | APPROVED | REJECTED
  reviewedById String?
  reviewNote   String?
  createdAt    DateTime       @default(now())
  reviewedAt   DateTime?
}

model PriceChangeLog {
  id          String   @id @default(cuid())
  entity      String // ServicePrice | DiscountTier | BookingType | TaxSetting | VisitFeePolicy
  entityId    String
  before      Json?
  after       Json?
  changedById String?
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
}

// ===== Roles, permissions & audit =====

model AdminRole {
  id          String     @id @default(cuid())
  key         String     @unique // OWNER | ADMIN | EDITOR | SEO | OPERATIONS | VIEWER
  name        String
  permissions String[]
  employees   Employee[]
}

// Every admin mutation: who, when, what, before/after.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  action    String // e.g. "pricing.price.set"
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
  @@index([createdAt])
}

// ===== Website CMS (block-based pages) =====

// One row per page. Content is bilingual inside the blocks (every text prop is {en, ar}), so a
// page serves both locales; translationGroupId is reserved for splitting locales later.
// draftBlocks/draftSeo are what the editor works on; the live site only ever reads the
// published CmsPageVersion snapshot, so editing never touches what visitors see until Publish.
model CmsPage {
  id                 String           @id @default(cuid())
  slug               String           @unique
  type               String           @default("page") // page | service | area | article | landing
  status             String           @default("DRAFT") // DRAFT | PUBLISHED | SCHEDULED | ARCHIVED
  publishAt          DateTime?
  titleEn            String
  titleAr            String
  showInMenus        Boolean          @default(true)
  showInSitemap      Boolean          @default(true)
  translationGroupId String?
  areaId             String?
  area               ServiceArea?     @relation(fields: [areaId], references: [id], onDelete: SetNull)
  showLastUpdated    Boolean          @default(false)
  draftBlocks        Json             @default("[]")
  draftSeo           Json             @default("{}")
  publishedVersionId String?          @unique
  publishedVersion   CmsPageVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id])
  scheduledVersionId String?
  versions           CmsPageVersion[] @relation("PageVersions")
  deletedAt          DateTime?
  createdById        String?
  updatedById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt

  @@index([status, deletedAt])
}

// Immutable snapshot (content + SEO) created on every manual save, publish and restore.
model CmsPageVersion {
  id            String   @id @default(cuid())
  pageId        String
  page          CmsPage  @relation("PageVersions", fields: [pageId], references: [id], onDelete: Cascade)
  version       Int
  kind          String // SAVE | PUBLISH | SCHEDULE | RESTORE
  slug          String
  titleEn       String
  titleAr       String
  blocks        Json
  seo           Json
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  publishedFor  CmsPage? @relation("PublishedVersion")

  @@unique([pageId, version])
}

// Created automatically when a published slug changes; served as a 301 by the public site.
model CmsRedirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  permanent Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ===== Site settings, menus, social (website CMS) =====

// Single row (id = "default"). The one source of truth for brand + contact details
// (name, phone, WhatsApp, email, address) used by header, footer, contact page and structured data.
model SiteSettings {
  id                 String   @id @default("default")
  siteNameEn         String   @default("OSTA Services")
  siteNameAr         String   @default("خدمات أسطا")
  taglineEn          String   @default("Your Comfort. Our Priority.")
  taglineAr          String   @default("راحتك. أولويتنا.")
  descriptionEn      String   @default("")
  descriptionAr      String   @default("")
  logoUrl            String   @default("")
  faviconUrl         String   @default("")
  defaultLocale      String   @default("en")
  allowIndexing      Boolean  @default(true)
  copyrightEn        String   @default("All rights reserved.")
  copyrightAr        String   @default("جميع الحقوق محفوظة.")
  phone              String   @default("")
  whatsapp           String   @default("")
  whatsappMessageEn  String   @default("")
  whatsappMessageAr  String   @default("")
  email              String   @default("")
  addressEn          String   @default("")
  addressAr          String   @default("")
  hoursEn            String   @default("")
  hoursAr            String   @default("")
  mapsUrl            String   @default("")
  businessProfileUrl String   @default("")
  headerCtaLabelEn   String   @default("Book Now")
  headerCtaLabelAr   String   @default("احجز الآن")
  headerCtaUrl       String   @default("/orders/new")
  footerAreas        Json     @default("[]") // [{ en, ar }]
  updatedAt          DateTime @default(now()) @updatedAt
}

// Two levels deep (item -> children). menu: "header" | "footer".
model MenuItem {
  id          String     @id @default(cuid())
  menu        String
  parentId    String?
  parent      MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    MenuItem[] @relation("MenuTree")
  labelEn     String
  labelAr     String
  url         String
  sortOrder   Int        @default(0)
  visible     Boolean    @default(true)
  showDesktop Boolean    @default(true)
  showMobile  Boolean    @default(true)
  newTab      Boolean    @default(false)

  @@index([menu, sortOrder])
}

model SocialLink {
  id        String  @id @default(cuid())
  platform  String // facebook | instagram | linkedin | tiktok | youtube | x | whatsapp | custom
  label     String  @default("")
  url       String
  sortOrder Int     @default(0)
  visible   Boolean @default(true)
}

// ===== Media library =====

model MediaFolder {
  id        String       @id @default(cuid())
  name      String
  assets    MediaAsset[]
  createdAt DateTime     @default(now())

  @@unique([name])
}

// Uploaded images are converted to WebP at several widths and stored in the database
// (see MediaVariant), so no external storage account is needed. Public URL: /api/media/<id>.
model MediaAsset {
  id             String         @id @default(cuid())
  folderId       String?
  folder         MediaFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name           String // display / file name, editable
  originalName   String
  originalMime   String
  width          Int
  height         Int
  originalBytes  Int
  altEn          String         @default("")
  altAr          String         @default("")
  title          String         @default("")
  caption        String         @default("")
  variants       MediaVariant[]
  uploadedById   String?
  uploadedByName String?
  createdAt      DateTime       @default(now())

  @@index([folderId, createdAt])
}

model MediaVariant {
  id      String     @id @default(cuid())
  assetId String
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  width   Int
  height  Int
  format  String     @default("webp")
  bytes   Int
  data    Bytes

  @@unique([assetId, width, format])
}

// Where OSTA works: an emirate or a smaller area/city inside one. Phone, address and hours are NOT repeated here:
// they come from SiteSettings so there is a single source of truth (NAP) everywhere.
model ServiceArea {
  id        String            @id @default(cuid())
  regionId  String
  region    Region            @relation(fields: [regionId], references: [id])
  slug      String            @unique
  nameEn    String
  nameAr    String
  kind      String            @default("area") // emirate | area
  latitude  Float?
  longitude Float?
  mapsUrl   String            @default("")
  active    Boolean           @default(true)
  sortOrder Int               @default(0)
  services  BookableService[] @relation("AreaServices")
  pages     CmsPage[]
  createdAt DateTime          @default(now())
}

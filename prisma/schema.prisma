generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  ADMIN
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

model Setting {
  id                  String   @id @default(cuid())
  logoData            String?
  certificateLogoData String?
  updatedAt           DateTime @updatedAt
}

model Team {
  id                   String                @id @default(cuid())
  name                 String                @unique
  employees            Employee[]
  invoices             Invoice[]
  expenses             Expense[]
  workReports          WorkReport[]
  quotations           Quotation[]
  warrantyCertificates WarrantyCertificate[]
}

model Employee {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  jobTitle  String
  role      Role       @default(EMPLOYEE)
  pinHash   String
  status    String     @default("active")
  phone     String?
  photoData String?
  custody   Float      @default(0)
  revenueWithdrawn Float @default(0)
  walletResetAt DateTime?
  monthlySalary Float  @default(0)
  hasWallet Boolean    @default(true)
  teamId    String?
  team      Team?      @relation(fields: [teamId], references: [id])
  invoices  Invoice[]
  expenses  Expense[]
  payrollEntries        PayrollEntry[] @relation("PayrollFor")
  payrollEntriesCreated PayrollEntry[] @relation("PayrollCreatedBy")
  workReports           WorkReport[]
  quotations            Quotation[]
  warrantyCertificates  WarrantyCertificate[]
  createdAt DateTime   @default(now())
}

model Customer {
  id           String       @id @default(cuid())
  type         CustomerType @default(INDIVIDUAL)
  name         String
  companyName  String?
  trn          String?
  phone        String       @unique
  emirate      String
  buildingName String?
  flatNo       String?
  invoices     Invoice[]
  createdAt    DateTime     @default(now())
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  date          DateTime
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  serviceType   String        @default("Repair")
  category      String        @default("AC")
  payment       String
  amount        Float
  status        String        @default("Paid")
  refundedAmount Float        @default(0)
  leadSource    String        @default("Organic")
  warrantyUntil DateTime?
  teamId        String?
  team          Team?         @relation(fields: [teamId], references: [id])
  createdById   String
  createdBy     Employee      @relation(fields: [createdById], references: [id])
  items         InvoiceItem[]
  createdAt     DateTime      @default(now())
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceName String
  description String?
  qty         Int     @default(1)
  unitPrice   Float
}

model Expense {
  id             String   @id @default(cuid())
  date           DateTime
  description    String
  category       String?
  vehicle        String?
  subcategory    String?
  payment        String   @default("Cash")
  amount         Float
  status         String   @default("Recorded")
  refundedAmount Float    @default(0)
  attachmentUrl  String?
  teamId         String?
  team           Team?    @relation(fields: [teamId], references: [id])
  createdById    String
  createdBy      Employee @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
}

model WorkReport {
  id            String            @id @default(cuid())
  date          DateTime
  customerName  String?
  customerPhone String?
  emirate       String?
  buildingName  String?
  flatNo        String?
  teamId        String?
  team          Team?             @relation(fields: [teamId], references: [id])
  createdById   String
  createdBy     Employee          @relation(fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())
  items         WorkReportItem[]
}

model WorkReportItem {
  id          String            @id @default(cuid())
  reportId    String
  report      WorkReport        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  deviceType  String
  tonnage     String?
  gasType     String?
  brand       String?
  condition   String
  description String?
  photos      WorkReportPhoto[]
}

model WorkReportPhoto {
  id      String         @id @default(cuid())
  itemId  String
  item    WorkReportItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  dataUrl String
}

model Quotation {
  id           String          @id @default(cuid())
  number       String          @unique
  date         DateTime
  customerType CustomerType    @default(INDIVIDUAL)
  customerName String
  companyName  String?
  trn          String?
  phone        String?
  emirate      String?
  buildingName String?
  flatNo       String?
  teamId       String?
  team         Team?           @relation(fields: [teamId], references: [id])
  createdById  String
  createdBy    Employee        @relation(fields: [createdById], references: [id])
  items        QuotationItem[]
  createdAt    DateTime        @default(now())
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  serviceName String
  description String?
  qty         Int       @default(1)
  unitPrice   Float
}

model WarrantyCertificate {
  id                String   @id @default(cuid())
  date              DateTime
  customerName      String
  emirate           String?
  phone             String?
  address           String?
  serviceProvided   String
  equipmentLocation String?
  warrantyFrom      DateTime
  warrantyTo        DateTime
  teamSupervisor    String?
  teamId            String?
  team              Team?    @relation(fields: [teamId], references: [id])
  createdById       String
  createdBy         Employee @relation(fields: [createdById], references: [id])
  createdAt         DateTime @default(now())
}

model PayrollEntry {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation("PayrollFor", fields: [employeeId], references: [id])
  type        String
  amount      Float
  date        DateTime
  note        String?
  createdById String
  createdBy   Employee @relation("PayrollCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

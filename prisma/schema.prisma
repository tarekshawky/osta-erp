generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  ADMIN
  SUPER_ADMIN
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

model Setting {
  id                  String  @id @default(cuid())
  logoData            String?
  certificateLogoData String?
  collectMoneyTotal   Float   @default(0)
  // The numbered Terms & Conditions and the Warranty Terms printed on invoices, as { general: {en, ar}[], warranty: {en, ar}[] }, edited in
  // Settings > Invoice terms. null = the built-in wording (see src/lib/invoiceTerms.ts).
  invoiceTerms        Json?

  // Tax Information. taxRegistrationEffectiveDate (NOT taxCertificateIssueDate, NOT
  // "today") is what defines the start of every dynamic Financial Report period --
  // kept as a separate field so the two dates can never be confused in code or UI.
  taxRegistrationNumber        String?
  taxRegistrationEffectiveDate DateTime?
  taxCertificateIssueDate      DateTime?
  firstTaxPeriodStart          DateTime?
  firstTaxPeriodEnd            DateTime?
  firstTaxReturnFilingDueDate  DateTime?

  // Equity inputs with no other source anywhere in the system.
  shareCapital      Float?
  statutoryReserves Float?

  // Authorized Signatory block, shown on every Financial Report export.
  signatoryName        String?
  signatoryDesignation String?

  // Which Employee's wallet position (custody + cash - expenses) represents the
  // Shareholder's Current Account line on the Balance Sheet. Defaults to the sole
  // current Admin until changed.
  shareholderEmployeeId String?
  shareholderEmployee   Employee? @relation("SettingShareholder", fields: [shareholderEmployeeId], references: [id])

  updatedAt DateTime @updatedAt
}

model Team {
  id                   String                @id @default(cuid())
  name                 String                @unique
  employees            Employee[]
  invoices             Invoice[]
  expenses             Expense[]
  workReports          WorkReport[]
  quotations           Quotation[]
  warrantyCertificates WarrantyCertificate[]
  orders               Order[]
  schedule             TeamSchedule?
  calendarEntries      CalendarEntry[]
}

model Employee {
  id                           String                         @id @default(cuid())
  code                         String                         @unique
  name                         String
  jobTitle                     String
  role                         Role                           @default(EMPLOYEE)
  pinHash                      String
  status                       String                         @default("active")
  phone                        String?
  photoData                    String?
  custody                      Float                          @default(0)
  revenueWithdrawn             Float                          @default(0)
  walletResetAt                DateTime?
  monthlySalary                Float                          @default(0)
  hasWallet                    Boolean                        @default(true)
  canViewCreditCardWallets     Boolean                        @default(false)
  invoicesAccess               String                         @default("No Access")
  expensesAccess               String                         @default("No Access")
  // Which /admin dashboard sections a plain ADMIN can see (Employee.role
  // ADMIN, not SUPER_ADMIN). Empty = unrestricted (sees everything) -- the
  // default, so no existing or newly-created Admin loses access until a
  // Super Admin explicitly narrows this list. Ignored entirely for
  // SUPER_ADMIN, who is always unrestricted. See src/lib/adminSections.ts.
  adminSections                String[]                       @default([])
  // Optional granular permission role for an ADMIN. Null = full admin access, exactly as before, so no
  // existing admin loses anything until a Super Admin assigns a narrower role. SUPER_ADMIN ignores it.
  adminRoleId                  String?
  adminRole                    AdminRole?                     @relation(fields: [adminRoleId], references: [id])
  joinDate                     DateTime?
  endOfServiceDate             DateTime?
  teamId                       String?
  team                         Team?                          @relation(fields: [teamId], references: [id])
  invoices                     Invoice[]
  jobsCreated                  Job[]                          @relation("JobCreatedBy")
  expenses                     Expense[]
  payrollEntries               PayrollEntry[]                 @relation("PayrollFor")
  payrollEntriesCreated        PayrollEntry[]                 @relation("PayrollCreatedBy")
  workReports                  WorkReport[]
  quotations                   Quotation[]
  warrantyCertificates         WarrantyCertificate[]
  ordersAssigned               Order[]                        @relation("OrderAssignedTo")
  ordersCreated                Order[]                        @relation("OrderCreatedBy")
  ordersDone                   Order[]                        @relation("OrderDoneBy")
  ordersCancelled              Order[]                        @relation("OrderCancelledBy")
  ordersRescheduled            Order[]                        @relation("OrderRescheduledBy")
  orderStatusChanges           OrderStatusChange[]
  invoiceStatusChanges         InvoiceStatusChange[]
  invoicePayments              InvoicePayment[]               @relation("InvoicePaymentBy")
  customerPurchasesCreated     CustomerPurchase[]             @relation("CustomerPurchaseCreatedBy")
  customersCreated             Customer[]                     @relation("CustomerCreatedBy")
  customersUpdated             Customer[]                     @relation("CustomerUpdatedBy")
  blogPostsCreated             BlogPost[]                     @relation("BlogPostCreatedBy")
  blogPostsUpdated             BlogPost[]                     @relation("BlogPostUpdatedBy")
  servicePagesCreated          ServicePage[]                  @relation("ServicePageCreatedBy")
  servicePagesUpdated          ServicePage[]                  @relation("ServicePageUpdatedBy")
  homeSectionsUpdated          HomeSection[]                  @relation("HomeSectionUpdatedBy")
  customerNotesCreated         CustomerNote[]
  creditCardsCreated           CreditCard[]                   @relation("CreditCardCreatedBy")
  creditCardPaymentsRecorded   CreditCardPayment[]            @relation("CreditCardPaymentRecordedBy")
  creditCardAuditLogs          CreditCardAuditLog[]           @relation("CreditCardAuditLogPerformedBy")
  vehiclesCreated              Vehicle[]                      @relation("VehicleCreatedBy")
  vehicleExpensesResponsible   Expense[]                      @relation("ExpenseResponsibleEmployee")
  assetsCreated                Asset[]                        @relation("AssetCreatedBy")
  liabilitiesCreated           Liability[]                    @relation("LiabilityCreatedBy")
  cashPositionUpdates          CashPosition[]                 @relation("CashPositionUpdatedBy")
  settingsAsShareholder        Setting[]                      @relation("SettingShareholder")
  rentalAgreementsCreated      RentalAgreement[]              @relation("RentalAgreementCreatedBy")
  inventoryItemsCreated        InventoryItem[]                @relation("InventoryItemCreatedBy")
  inventoryTransactionsCreated InventoryTransaction[]         @relation("InventoryTransactionCreatedBy")
  inventoryRequirements        EmployeeInventoryRequirement[] @relation("InventoryRequirementFor")
  inventoryRequirementsCreated EmployeeInventoryRequirement[] @relation("InventoryRequirementCreatedBy")
  inventoryUsages              InvoiceInventoryUsage[]
  suppliersCreated             Supplier[]                     @relation("SupplierCreatedBy")
  labourItemsCreated           LabourItem[]                   @relation("LabourItemCreatedBy")
  inventoryCategoriesCreated   InventoryCategory[]            @relation("InventoryCategoryCreatedBy")
  stockRequestsSubmitted       StockRequest[]                 @relation("StockRequestBy")
  stockRequestsDecided         StockRequest[]                 @relation("StockRequestDecidedBy")
  stockReturnRequestsSubmitted StockReturnRequest[]           @relation("StockReturnRequestBy")
  stockReturnRequestsDecided   StockReturnRequest[]           @relation("StockReturnRequestDecidedBy")
  sparePartPriceModification   String                         @default("Not Allowed")
  sparePartMaxDiscountPercent  Float?
  labourPriceModification      String                         @default("Not Allowed")
  labourMaxDiscountPercent     Float?
  createdAt                    DateTime                       @default(now())
}

model Customer {
  id                String               @id @default(cuid())
  code              String               @unique
  type              CustomerType         @default(INDIVIDUAL)
  name              String
  companyName       String?
  trn               String?
  phone             String               @unique
  whatsapp          String?
  email             String?              @unique
  passwordHash      String?
  language          String               @default("Arabic")
  emirate           String
  city              String?
  area              String?
  buildingType      String?
  buildingName      String?
  flatNo            String?
  address           String?
  locationUrl       String?
  notes             String?
  status            String               @default("Active")
  // First-touch attribution: how this customer originally found OSTA. Set once at
  // creation (by whichever flow -- Add Customer, New Order, or New Invoice -- created
  // the record) and not overwritten afterward, unlike Invoice.leadSource which is
  // chosen per-invoice and drives the Marketing dashboard's revenue attribution.
  leadSource        String               @default("Organic")
  createdById       String?
  createdBy         Employee?            @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  updatedById       String?
  updatedBy         Employee?            @relation("CustomerUpdatedBy", fields: [updatedById], references: [id])
  passwordResets    PasswordResetToken[]
  reviews           OrderReview[]
  updatedAt         DateTime             @default(now()) @updatedAt
  invoices          Invoice[]
  orders            Order[]
  quotations        Quotation[]
  customerNotes     CustomerNote[]
  rentalAgreements  RentalAgreement[]
  customerPurchases CustomerPurchase[]
  contracts         Contract[]
  selfQuotes        SelfQuote[]
  createdAt         DateTime             @default(now())
}

model CustomerNote {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  note        String
  createdById String
  createdBy   Employee @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// A second, independent financial relationship a Customer can have with OSTA --
// OSTA renting accommodation/office/etc. FROM that customer. Deliberately kept
// entirely separate from Invoice/Order revenue and Accounts Receivable (see
// RentalTransaction below) so the two flows -- Customer -> OSTA revenue, and
// OSTA -> Customer rent expense -- never net against each other.
model RentalAgreement {
  id               String              @id @default(cuid())
  customerId       String
  customer         Customer            @relation(fields: [customerId], references: [id])
  agreementName    String
  rentalType       String // Accommodation | Office | Warehouse | Shop | Staff Accommodation | Other
  monthlyRent      Float
  paymentFrequency String              @default("Monthly") // Monthly | Quarterly | Semi-Annual | Annual | Custom
  startDate        DateTime
  endDate          DateTime?
  paymentDueDay    Int                 @default(1) // 1-31
  paymentMethod    String              @default("Bank Transfer")
  notes            String?
  status           String              @default("Active") // Active | Suspended | Expired | Cancelled
  createdById      String
  createdBy        Employee            @relation("RentalAgreementCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime            @default(now())
  transactions     RentalTransaction[]
}

// One row per billing period, mirroring VehicleFineInstallment's expenseId-pairing
// pattern. The @@unique constraint is what structurally guarantees "do not create
// duplicate transactions if the monthly transaction already exists" -- generation
// pre-queries existing periods, and this is the hard backstop against races.
model RentalTransaction {
  id                String          @id @default(cuid())
  rentalAgreementId String
  rentalAgreement   RentalAgreement @relation(fields: [rentalAgreementId], references: [id], onDelete: Cascade)
  billingPeriod     DateTime // first-of-month marker for the period this covers
  dueDate           DateTime
  amount            Float
  paymentStatus     String          @default("Pending") // Pending | Due | Overdue | Paid | Cancelled
  paymentDate       DateTime?
  paymentMethod     String?
  referenceNumber   String?
  notes             String?
  expenseId         String?         @unique
  expense           Expense?        @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())

  @@unique([rentalAgreementId, billingPeriod])
}

model Invoice {
  id                    String                  @id @default(cuid())
  number                String                  @unique
  date                  DateTime
  customerId            String
  customer              Customer                @relation(fields: [customerId], references: [id])
  serviceType           String                  @default("Repair")
  category              String                  @default("AC")
  payment               String
  amount                Float
  status                String                  @default("Unpaid")
  paymentLink           String?
  // Collection tracking, kept apart from the invoice date (which never changes when a payment arrives later):
  // paidAmount = money actually received so far, paymentDate = when the last payment was received (null while nothing
  // is received). Remaining balance = amount - paidAmount. Status "Paid" always means paidAmount == amount.
  paidAmount            Float                   @default(0)
  paymentDate           DateTime?
  refundedAmount        Float                   @default(0)
  leadSource            String                  @default("Organic")
  // Warranty is chosen per invoice. warrantyMode: null = an invoice made before the choice existed (the old fixed 14 days, kept as it
  // was); "NONE" = no warranty; "WITH" = warranty of warrantyDays (7 | 14 | 30) counted from warrantyStartDate, the day the work was
  // completed. warrantyStartDate stays null while the work is not finished (status Pending). warrantyUntil is the expiry date.
  warrantyMode          String?
  warrantyDays          Int?
  warrantyStartDate     DateTime?
  warrantyUntil         DateTime?
  teamId                String?
  team                  Team?                   @relation(fields: [teamId], references: [id])
  createdById           String
  createdBy             Employee                @relation(fields: [createdById], references: [id])
  items                 InvoiceItem[]
  statusChanges         InvoiceStatusChange[]
  payments              InvoicePayment[]
  order                 Order?
  quotation             Quotation?
  inventoryTransactions InventoryTransaction[]
  inventoryUsages       InvoiceInventoryUsage[]
  createdAt             DateTime                @default(now())
}

model InvoiceStatusChange {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  previousStatus String
  newStatus      String
  changedById    String
  changedBy      Employee @relation(fields: [changedById], references: [id])
  createdAt      DateTime @default(now())
}

model InvoiceItem {
  id              String         @id @default(cuid())
  invoiceId       String
  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceName     String
  description     String?
  qty             Int            @default(1)
  unitPrice       Float
  // Spare Parts Catalog additions -- all additive/nullable. itemType defaults
  // to "Service" so every existing row and code path keeps working unchanged.
  // unitPrice keeps meaning "final, actually-charged price"; originalPrice is
  // only set for SparePart/Labour lines (the catalog price at add-time).
  itemType        String         @default("Service") // "Service" | "SparePart" | "Labour"
  originalPrice   Float?
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  labourItemId    String?
  labourItem      LabourItem?    @relation(fields: [labourItemId], references: [id])
}

model Order {
  id                String             @id @default(cuid())
  number            String             @unique
  date              DateTime           @default(now())
  scheduledAt       DateTime?
  customerId        String
  customer          Customer           @relation(fields: [customerId], references: [id])
  locationUrl       String?
  orderType         String             @default("New Order")
  priceAgreed       String             @default("No")
  customerLanguage  String             @default("Arabic")
  leadSource        String             @default("Organic")
  notes             String?
  status            String             @default("Assigned")
  teamId            String?
  team              Team?              @relation(fields: [teamId], references: [id])
  // Nullable to support customer self-service booking via the API (status "Requested"),
  // which has no employee assigned or creating it yet -- an admin triages it via the
  // Edit Order form, which assigns both and flips status to "Assigned".
  assignedToId      String?
  assignedTo        Employee?          @relation("OrderAssignedTo", fields: [assignedToId], references: [id])
  createdById       String?
  createdBy         Employee?          @relation("OrderCreatedBy", fields: [createdById], references: [id])
  invoiceId         String?            @unique
  invoice           Invoice?           @relation(fields: [invoiceId], references: [id])
  review            OrderReview?
  jobs              Job[]
  customerPurchases CustomerPurchase[]

  acceptedAt    DateTime?
  departedAt    DateTime?
  etaMinutes    String?
  arrivedAt     DateTime?
  arrivalGpsLat Float?
  arrivalGpsLng Float?
  workStartedAt DateTime?
  jobNotes      String?

  photos OrderPhoto[]

  // Dynamic pricing (all nullable so every pre-existing order stays valid). Money is
  // integer fils. pricingSnapshot is the full immutable quote JSON taken at creation.
  regionId          String?
  region            Region?          @relation(fields: [regionId], references: [id])
  bookableServiceId String?
  bookableService   BookableService? @relation(fields: [bookableServiceId], references: [id])
  bookingTypeId     String?
  bookingType       BookingType?     @relation(fields: [bookingTypeId], references: [id])
  quantity          Int?
  totalFils         Int?
  pricingSnapshot   Json?
  visitFeePolicyId  String?
  visitFeePolicy    VisitFeePolicy?  @relation(fields: [visitFeePolicyId], references: [id])
  consentAcceptedAt DateTime?
  idempotencyKey    String?          @unique
  events            OrderEvent[]
  visitFeeCharges   VisitFeeCharge[]
  calendarEntry     CalendarEntry?

  // Admin-only status overrides (Done / Cancelled / Reschedule) -- see OrderStatusChange
  // for the full audit trail, including the before/after appointment on each reschedule.
  doneAt             DateTime?
  doneById           String?
  doneBy             Employee?           @relation("OrderDoneBy", fields: [doneById], references: [id])
  cancelledAt        DateTime?
  cancelledById      String?
  cancelledBy        Employee?           @relation("OrderCancelledBy", fields: [cancelledById], references: [id])
  cancellationReason String?
  rescheduledAt      DateTime?
  rescheduledById    String?
  rescheduledBy      Employee?           @relation("OrderRescheduledBy", fields: [rescheduledById], references: [id])
  rescheduleReason   String?
  statusChanges      OrderStatusChange[]

  createdAt DateTime @default(now())
}

model OrderStatusChange {
  id                  String    @id @default(cuid())
  orderId             String
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousStatus      String
  newStatus           String
  reason              String?
  // Only set on Reschedule changes -- preserves the appointment that was in effect
  // right before this change, so a chain of reschedules stays fully reconstructable.
  previousScheduledAt DateTime?
  newScheduledAt      DateTime?
  changedById         String
  changedBy           Employee  @relation(fields: [changedById], references: [id])
  createdAt           DateTime  @default(now())
}

model OrderPhoto {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      String
  dataUrl   String
  createdAt DateTime @default(now())
}

model Expense {
  id                    String                   @id @default(cuid())
  number                String?                  @unique
  date                  DateTime
  description           String
  vendor                String?
  referenceNumber       String?
  notes                 String?
  category              String?
  vehicle               String?
  subcategory           String?
  payment               String                   @default("Cash")
  amount                Float
  status                String                   @default("Recorded")
  refundedAmount        Float                    @default(0)
  attachmentUrl         String?
  teamId                String?
  team                  Team?                    @relation(fields: [teamId], references: [id])
  creditCardId          String?
  creditCard            CreditCard?              @relation(fields: [creditCardId], references: [id])
  // Vehicle Management System fields -- vehicle is left as the legacy free-text
  // label (only ever read for the one-time historical backfill / display fallback);
  // new Vehicle-category expenses only ever set vehicleId going forward.
  vehicleId             String?
  vehicleRef            Vehicle?                 @relation("ExpenseVehicle", fields: [vehicleId], references: [id])
  odometer              Int?
  // Second-level type within a Vehicle expense's subcategory: Service Type when
  // subcategory=Service, Fuel Type when subcategory="Petrol / Fuel", Fine Type
  // when subcategory=Fine -- reuses one column the same way `subcategory` already
  // serves both Vehicle and Advertising categories.
  detailType            String?
  liters                Float?
  responsibleEmployeeId String?
  responsibleEmployee   Employee?                @relation("ExpenseResponsibleEmployee", fields: [responsibleEmployeeId], references: [id])
  companyAmount         Float? // Fine only
  employeeAmount        Float? // Fine only
  nextServiceInterval   Int? // Service only, in KM
  fineInstallments      VehicleFineInstallment[]
  rentalTransaction     RentalTransaction?
  // Expense classification (additive; every older row keeps null and is read as a company expense):
  // COMPANY | EMPLOYEE | CUSTOMER_PURCHASE. expenseKind is the type inside it (Daily Worker, Equipment Rental, ...), emirate the
  // emirate it belongs to, and details the type-specific fields (worker name, days, daily rate, supplier, dates, ...).
  expenseClass          String?
  expenseKind           String?
  emirate               String?
  details               Json?
  customerPurchase      CustomerPurchase?
  createdById           String
  createdBy             Employee                 @relation(fields: [createdById], references: [id])
  createdAt             DateTime                 @default(now())

  @@index([expenseClass, date])
}

// One card = one independent wallet: its own limit, expenses, payments, statement.
// Only the last 4 digits of the card number are ever persisted -- the full number
// is never sent to the server or stored, since this app never needs to redisplay
// or reuse it (avoids taking on PCI-DSS scope for zero functional benefit).
model CreditCard {
  id             String               @id @default(cuid())
  name           String
  cardHolder     String?
  lastFour       String
  creditLimit    Float                @default(0)
  billingCycle   String?
  paymentDueDate Int?
  status         String               @default("Active")
  notes          String?
  expenses       Expense[]
  payments       CreditCardPayment[]
  auditLogs      CreditCardAuditLog[]
  createdById    String
  createdBy      Employee             @relation("CreditCardCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime             @default(now())
}

// Settlement/payment against a card's outstanding balance -- deliberately never
// creates or touches an Expense row, so a payment can never double-count as spend.
model CreditCardPayment {
  id              String     @id @default(cuid())
  creditCardId    String
  creditCard      CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  date            DateTime
  amount          Float
  paymentMethod   String
  bankAccount     String?
  referenceNumber String?
  notes           String?
  recordedById    String
  recordedBy      Employee   @relation("CreditCardPaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt       DateTime   @default(now())
}

model CreditCardAuditLog {
  id            String     @id @default(cuid())
  creditCardId  String
  creditCard    CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  action        String
  description   String
  oldValue      String?
  newValue      String?
  performedById String
  performedBy   Employee   @relation("CreditCardAuditLogPerformedBy", fields: [performedById], references: [id])
  createdAt     DateTime   @default(now())
}

// Admin-added expense categories on top of the hardcoded EXPENSE_CATEGORIES list
// in src/lib/expenseData.ts -- additive only (no edit/delete in this pass).
model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// Current odometer and next-service-due are deliberately NOT stored here -- both
// are computed on the fly from Expense rows (src/lib/vehicleData.ts), mirroring
// how getCreditCardWalletSummary never denormalizes a running balance onto
// CreditCard. initialOdometer is the one stored baseline, used only when a
// vehicle has zero odometer-bearing Expense rows yet.
model Vehicle {
  id                 String    @id @default(cuid())
  name               String    @unique // must match historical Expense.vehicle strings for backfill
  owner              String?
  plateType          String?
  plateNumber        String?
  licensingAuthority String?
  trafficCode        String?
  licenseExpiry      DateTime?
  insuranceExpiry    DateTime?
  policyNumber       String?
  insuranceCompany   String?
  insuranceType      String?
  year               Int?
  chassisNumber      String?
  initialOdometer    Int       @default(0)
  registrationDocUrl String?
  insuranceDocUrl    String?
  status             String    @default("Active") // "Active" | "Inactive"
  notes              String?
  expenses           Expense[] @relation("ExpenseVehicle")
  createdById        String
  createdBy          Employee  @relation("VehicleCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime  @default(now())
}

// One row per fine-deduction installment, created upfront (all N at once,
// atomically with Expense.create) at fine-save time -- never lazily
// materialized. Remembers which PayrollEntry belongs to which fine / which
// installment-of-N so the Fines tab can render "2 of 3 deducted" without
// string-matching PayrollEntry.note. onDelete: Cascade on payrollEntry means
// deleting a Deduction row from the existing Payroll page automatically keeps
// this table's counts (and therefore the derived fine status) accurate.
model VehicleFineInstallment {
  id             String       @id @default(cuid())
  expenseId      String
  expense        Expense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  installmentNo  Int // 1-based, 1..totalCount
  totalCount     Int // N -- 1 for "One Time"
  amount         Float
  month          DateTime // first-of-month marker, mirrors the linked PayrollEntry's date
  payrollEntryId String       @unique
  payrollEntry   PayrollEntry @relation(fields: [payrollEntryId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

// Property, Plant & Equipment register for the Balance Sheet's Non-Current Assets
// line. No accumulatedDepreciation column -- depreciation is computed at query
// time in financialReportsBalanceSheet.ts (straight-line), mirroring the
// established "never denormalize a computed running value" convention already
// used by CreditCard.outstanding and the Vehicle odometer.
model Asset {
  id                 String   @id @default(cuid())
  name               String
  category           String // "Vehicle" | "Equipment" | "Furniture" | "Tools" | "Property" | "Other"
  purchaseCost       Float
  purchaseDate       DateTime
  usefulLifeYears    Int
  depreciationMethod String   @default("Straight-Line")
  notes              String?
  createdById        String
  createdBy          Employee @relation("AssetCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime @default(now())
}

// Register of liabilities with no other derivable source (bank loans, other
// longer-term obligations). Deliberately excludes: credit-card balances (live
// from CreditCard/CreditCardPayment) and Accounts Payable (structurally always 0
// -- no vendor-bill workflow exists in this business).
model Liability {
  id          String   @id @default(cuid())
  name        String
  type        String // "Bank Borrowing" | "Other"
  category    String // "Current" | "Non-Current"
  amount      Float
  notes       String?
  createdById String
  createdBy   Employee @relation("LiabilityCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// Admin-entered opening cash balance as of a chosen date -- the ERP has never
// tracked a running cash balance before now, so there's no way to derive this
// from existing data. Every subsequent cash-like transaction is netted forward
// from here at query time (financialReportsBalanceSheet.ts); this row is never
// itself rewritten by report computation, only by an explicit admin edit.
model CashPosition {
  id             String    @id @default(cuid())
  openingBalance Float     @default(0)
  openingDate    DateTime?
  updatedById    String?
  updatedBy      Employee? @relation("CashPositionUpdatedBy", fields: [updatedById], references: [id])
  updatedAt      DateTime  @updatedAt
}

model WorkReport {
  id            String           @id @default(cuid())
  date          DateTime
  customerName  String?
  customerPhone String?
  emirate       String?
  buildingName  String?
  flatNo        String?
  teamId        String?
  team          Team?            @relation(fields: [teamId], references: [id])
  createdById   String
  createdBy     Employee         @relation(fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())
  items         WorkReportItem[]
}

model WorkReportItem {
  id          String            @id @default(cuid())
  reportId    String
  report      WorkReport        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  deviceType  String
  tonnage     String?
  gasType     String?
  brand       String?
  condition   String
  description String?
  photos      WorkReportPhoto[]
}

model WorkReportPhoto {
  id      String         @id @default(cuid())
  itemId  String
  item    WorkReportItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  dataUrl String
}

model Quotation {
  id           String          @id @default(cuid())
  number       String          @unique
  date         DateTime
  customerType CustomerType    @default(INDIVIDUAL)
  customerName String
  companyName  String?
  trn          String?
  phone        String?
  emirate      String?
  buildingName String?
  flatNo       String?
  customerId   String?
  customer     Customer?       @relation(fields: [customerId], references: [id])
  teamId       String?
  team         Team?           @relation(fields: [teamId], references: [id])
  createdById  String
  createdBy    Employee        @relation(fields: [createdById], references: [id])
  items        QuotationItem[]
  invoiceId    String?         @unique
  invoice      Invoice?        @relation(fields: [invoiceId], references: [id])
  createdAt    DateTime        @default(now())
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  serviceName String
  description String?
  qty         Int       @default(1)
  unitPrice   Float
}

model WarrantyCertificate {
  id                String   @id @default(cuid())
  date              DateTime
  customerName      String
  emirate           String?
  phone             String?
  address           String?
  serviceProvided   String
  equipmentLocation String?
  warrantyFrom      DateTime
  warrantyTo        DateTime
  teamSupervisor    String?
  teamId            String?
  team              Team?    @relation(fields: [teamId], references: [id])
  createdById       String
  createdBy         Employee @relation(fields: [createdById], references: [id])
  createdAt         DateTime @default(now())
}

model PayrollEntry {
  id                     String                  @id @default(cuid())
  employeeId             String
  employee               Employee                @relation("PayrollFor", fields: [employeeId], references: [id])
  type                   String
  amount                 Float
  date                   DateTime
  note                   String?
  createdById            String
  createdBy              Employee                @relation("PayrollCreatedBy", fields: [createdById], references: [id])
  createdAt              DateTime                @default(now())
  vehicleFineInstallment VehicleFineInstallment?
}

model InventoryItem {
  id               String                         @id @default(cuid())
  name             String
  specification    String?
  unit             String
  category         String
  description      String?
  costPrice        Float?
  sellingPrice     Float?
  minimumMainStock Float                          @default(0)
  status           String                         @default("Active")
  // Spare Parts Catalog additions -- all nullable, not backfilled. Existing
  // rows (gas items, base Inventory test items) simply show blank for these.
  sku              String?                        @unique
  nameAr           String?
  subcategory      String?
  brand            String?
  model            String?
  compatibleType   String?
  maximumStock     Float?
  supplierId       String?
  supplier         Supplier?                      @relation(fields: [supplierId], references: [id])
  location         String? // shelf/bin text
  // Warehouse Hierarchy & Governance additions -- nullable, not backfilled.
  barcode          String?                        @unique
  transactions     InventoryTransaction[]
  requirements     EmployeeInventoryRequirement[]
  invoiceUsages    InvoiceInventoryUsage[]
  invoiceItems     InvoiceItem[]
  stockRequests    StockRequest[]
  returnRequests   StockReturnRequest[]
  createdById      String
  createdBy        Employee                       @relation("InventoryItemCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime                       @default(now())
}

// type distinguishes the one company-wide Main Warehouse (where real
// Purchase/Stock-Received events land) from every Branch Warehouse (which
// only ever receives via a Warehouse Transfer from Main). Existing rows
// default to "Branch" -- see scripts/seedWarehouseHierarchyAndCategories.ts
// for the one-time Main Warehouse seed.
model Warehouse {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String   @default("Branch") // "Main" | "Branch"
  status    String   @default("Active")
  createdAt DateTime @default(now())
}

// Admin-editable registry (Add/Edit/Deactivate) replacing the old hardcoded
// INVENTORY_CATEGORIES array. InventoryItem.category/.subcategory stay plain
// strings (unchanged) -- renaming a category cascades that string across
// every InventoryItem row in one transaction rather than via a foreign key.
model InventoryCategory {
  id            String                 @id @default(cuid())
  name          String                 @unique
  nameAr        String?
  status        String                 @default("Active")
  subcategories InventorySubcategory[]
  createdById   String
  createdBy     Employee               @relation("InventoryCategoryCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime               @default(now())
}

model InventorySubcategory {
  id         String            @id @default(cuid())
  categoryId String
  category   InventoryCategory @relation(fields: [categoryId], references: [id])
  name       String
  status     String            @default("Active")
  createdAt  DateTime          @default(now())

  @@unique([categoryId, name])
}

// Employee-initiated; Admin decides. Never a second balance source -- only
// Approved/PartiallyApproved rows trigger a real distributeStock() call in
// src/lib/inventoryData.ts. Pending/Rejected rows are pure workflow state.
model StockRequest {
  id                String        @id @default(cuid())
  employeeId        String
  employee          Employee      @relation("StockRequestBy", fields: [employeeId], references: [id])
  inventoryItemId   String
  inventoryItem     InventoryItem @relation(fields: [inventoryItemId], references: [id])
  requestedQuantity Float
  approvedQuantity  Float?
  reason            String?
  status            String        @default("Pending") // Pending | Approved | PartiallyApproved | Rejected
  sourceWarehouseId String? // set at decision time
  decidedById       String?
  decidedBy         Employee?     @relation("StockRequestDecidedBy", fields: [decidedById], references: [id])
  decidedAt         DateTime?
  createdAt         DateTime      @default(now())
}

// Employee-initiated return; Admin decides. Only an Approved row triggers a
// real returnToWarehouse() call.
model StockReturnRequest {
  id                     String        @id @default(cuid())
  employeeId             String
  employee               Employee      @relation("StockReturnRequestBy", fields: [employeeId], references: [id])
  inventoryItemId        String
  inventoryItem          InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantity               Float
  reason                 String // "Not Used" | "Wrong Part" | "Extra Stock" | "Other"
  status                 String        @default("Pending") // Pending | Approved | Rejected
  destinationWarehouseId String?
  decidedById            String?
  decidedBy              Employee?     @relation("StockReturnRequestDecidedBy", fields: [decidedById], references: [id])
  decidedAt              DateTime?
  createdAt              DateTime      @default(now())
}

model Supplier {
  id            String          @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  notes         String?
  status        String          @default("Active")
  items         InventoryItem[]
  createdById   String
  createdBy     Employee        @relation("SupplierCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
}

// Deliberately NOT an InventoryItem -- no stock, no InventoryTransaction, per
// spec Rule "these are NOT Inventory Items".
model LabourItem {
  id           String        @id @default(cuid())
  code         String        @unique
  nameAr       String
  nameEn       String
  defaultPrice Float
  status       String        @default("Active")
  invoiceItems InvoiceItem[]
  createdById  String
  createdBy    Employee      @relation("LabourItemCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime      @default(now())
}

// The sole source of truth for every stock movement. Current quantity at any
// location is ALWAYS derived -- SUM(quantity WHERE toLocation=X) minus
// SUM(quantity WHERE fromLocation=X) -- never stored on InventoryItem/Employee,
// mirroring how CreditCard.outstanding and vehicle odometer are computed on the
// fly elsewhere. fromLocation/toLocation are plain strings (not real FKs)
// holding "MAIN", an Employee.id, or null (external: a supplier on receipt, or
// consumed/damaged/lost/reversed on the way out) -- a relation can't
// conditionally point at a sentinel string or a real row.
model InventoryTransaction {
  id              String                 @id @default(cuid())
  number          String?                @unique
  inventoryItemId String
  inventoryItem   InventoryItem          @relation(fields: [inventoryItemId], references: [id])
  type            String
  quantity        Float
  fromLocation    String?
  toLocation      String?
  invoiceId       String?
  invoice         Invoice?               @relation(fields: [invoiceId], references: [id])
  reason          String?
  notes           String?
  createdById     String
  createdBy       Employee               @relation("InventoryTransactionCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime               @default(now())
  invoiceUsage    InvoiceInventoryUsage?
}

model EmployeeInventoryRequirement {
  id               String        @id @default(cuid())
  employeeId       String
  employee         Employee      @relation("InventoryRequirementFor", fields: [employeeId], references: [id])
  inventoryItemId  String
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id])
  requiredQuantity Float
  minimumQuantity  Float
  maximumQuantity  Float?
  createdById      String
  createdBy        Employee      @relation("InventoryRequirementCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([employeeId, inventoryItemId])
}

// Join/traceability row, mirroring VehicleFineInstallment's expenseId-pairing
// pattern: one row per {invoice, item}, pointing at the one "Stock Used"
// InventoryTransaction it created. Reversed (a new "Stock Reversed"
// transaction, never a silent delete) on invoice edit/delete.
model InvoiceInventoryUsage {
  id              String               @id @default(cuid())
  invoiceId       String
  invoice         Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem        @relation(fields: [inventoryItemId], references: [id])
  employeeId      String
  employee        Employee             @relation(fields: [employeeId], references: [id])
  quantity        Float
  transactionId   String               @unique
  transaction     InventoryTransaction @relation(fields: [transactionId], references: [id])
  createdAt       DateTime             @default(now())

  @@unique([invoiceId, inventoryItemId])
}

// Public marketing-site content, managed from /admin and served to the public
// website (ostaservices.com / the Next.js marketing app) via GET /api/v1/blog.
// Bilingual fields are flat En/Ar pairs rather than a JSON blob, matching this
// schema's existing convention of flat columns over nested structures.
model BlogPost {
  id                  String         @id @default(cuid())
  slug                String         @unique
  titleEn             String
  titleAr             String
  excerptEn           String
  excerptAr           String
  contentEn           String
  contentAr           String
  coverImageUrl       String?
  seoTitleEn          String?
  seoTitleAr          String?
  seoDescriptionEn    String?
  seoDescriptionAr    String?
  // Comma-separated SEO keywords (cleaned by normalizeKeywords).
  seoKeywordsEn       String?
  seoKeywordsAr       String?
  authorName          String?
  // Primary category (required in the editor; older posts may have none) plus optional secondary categories.
  categoryId          String?
  category            BlogCategory?  @relation("BlogPrimary", fields: [categoryId], references: [id], onDelete: SetNull)
  secondaryCategories BlogCategory[] @relation("BlogSecondary")
  featured            Boolean        @default(false)
  // Optional block-based body (same blocks as CMS pages). When it has blocks the public article shows them.
  blocks              Json           @default("[]")
  published           Boolean        @default(false)
  publishedAt         DateTime?
  createdById         String?
  createdBy           Employee?      @relation("BlogPostCreatedBy", fields: [createdById], references: [id])
  updatedById         String?
  updatedBy           Employee?      @relation("BlogPostUpdatedBy", fields: [updatedById], references: [id])
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @default(now()) @updatedAt

  @@index([published, publishedAt])
  @@index([categoryId])
}

// Blog categories ("sections"): managed in the admin, unlimited, bilingual, with their own SEO fields.
model BlogCategory {
  id               String     @id @default(cuid())
  slug             String     @unique
  nameEn           String
  nameAr           String
  descriptionEn    String     @default("")
  descriptionAr    String     @default("")
  seoTitleEn       String?
  seoTitleAr       String?
  seoDescriptionEn String?
  seoDescriptionAr String?
  seoKeywordsEn    String?
  seoKeywordsAr    String?
  coverImageUrl    String?
  active           Boolean    @default(true)
  sortOrder        Int        @default(0)
  posts            BlogPost[] @relation("BlogPrimary")
  secondaryPosts   BlogPost[] @relation("BlogSecondary")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @default(now()) @updatedAt

  @@index([active, sortOrder])
}

// Public marketing-site service pages (e.g. "AC Repair", "Duct Cleaning"), each
// with its own slug/content/price, served via GET /api/v1/services. Separate from
// the internal order-booking category list (osta-bookig-users' hardcoded SERVICES
// array) -- this model is purely marketing content, not tied to order creation.
model ServicePage {
  id                 String    @id @default(cuid())
  slug               String    @unique
  nameEn             String
  nameAr             String
  shortDescriptionEn String
  shortDescriptionAr String
  contentEn          String
  contentAr          String
  iconName           String?
  coverImageUrl      String?
  priceFrom          Float?
  priceNote          String?
  seoTitleEn         String?
  seoTitleAr         String?
  seoDescriptionEn   String?
  seoDescriptionAr   String?
  seoKeywordsEn      String?
  seoKeywordsAr      String?
  displayOrder       Int       @default(0)
  // Optional block-based body (same blocks as CMS pages). When it has blocks the public service page shows them.
  blocks             Json      @default("[]")
  published          Boolean   @default(true)
  createdById        String?
  createdBy          Employee? @relation("ServicePageCreatedBy", fields: [createdById], references: [id])
  updatedById        String?
  updatedBy          Employee? @relation("ServicePageUpdatedBy", fields: [updatedById], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  @@index([published, displayOrder])
}

// Generic, reusable content block for the marketing homepage's named sections
// (hero, sustainability, booking, why-choose-ajman, why-choose, areas-we-cover,
// brands-we-service, prime-membership, achievements -- see HOME_SECTION_KEYS in
// the admin). One row per section slot; `key` is a fixed set defined in code, not
// admin-creatable, but every other field (heading/description/image/items) is
// fully admin-editable via /admin/home-sections. `enabled` lets an admin hide a
// whole section from the live site without deleting its content.
model HomeSection {
  id            String            @id @default(cuid())
  key           String            @unique
  headingEn     String
  headingAr     String
  descriptionEn String?
  descriptionAr String?
  imageUrl      String?
  ctaLabelEn    String?
  ctaLabelAr    String?
  ctaUrl        String?
  enabled       Boolean           @default(true)
  displayOrder  Int               @default(0)
  items         HomeSectionItem[]
  updatedById   String?
  updatedBy     Employee?         @relation("HomeSectionUpdatedBy", fields: [updatedById], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt
}

// Repeating entries within a HomeSection -- a trust/feature card, a covered area,
// a serviced brand logo, an achievement, a Prime membership perk, etc. depending
// on which section it belongs to. Admin can add, edit, and delete these freely.
model HomeSectionItem {
  id            String      @id @default(cuid())
  sectionId     String
  section       HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  titleEn       String
  titleAr       String
  descriptionEn String?
  descriptionAr String?
  iconName      String?
  imageUrl      String?
  linkUrl       String?
  displayOrder  Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([sectionId, displayOrder])
}

// ===== Dynamic pricing =====

model Region {
  id           String                   @id @default(cuid())
  serviceAreas ServiceArea[]
  slug         String                   @unique
  nameEn       String
  nameAr       String
  active       Boolean                  @default(true)
  sortOrder    Int                      @default(0)
  // Price level of this emirate against the base price (Ajman, Umm Al Quwain and Al Ain = 1.00, Sharjah/RAK/Fujairah = 1.10, Dubai/Abu Dhabi = 1.20).
  priceFactor  Float                    @default(1)
  prices       ServicePrice[]
  optionPrices ServiceOptionPrice[]
  addOnPrices  AddOnPrice[]
  feeOverrides BookingTypeFeeOverride[]
  orders       Order[]
}

model BookableService {
  id                String                   @id @default(cuid())
  serviceAreas      ServiceArea[]            @relation("AreaServices")
  slug              String                   @unique
  nameEn            String
  nameAr            String
  descriptionEn     String?
  descriptionAr     String?
  imageUrl          String?
  pricingUnit       String                   @default("UNIT") // AC_UNIT | UNIT | ROOM | AREA_SQM | VISIT | FIXED
  // PRICED = the price comes from the price table (per emirate). INSPECTION = "price after inspection": bookable in every active
  // emirate with no price; the customer books a visit (plus any booking fee) and the admin sets the price after the inspection.
  priceMode         String                   @default("PRICED") // PRICED | INSPECTION
  // "Base starting price" (the Ajman / base-level price). An emirate without its own price row gets base x its price factor.
  basePriceFils     Int?
  // What the price is for, shown with it: "per sqm" / "للمتر المربع".
  unitLabelEn       String                   @default("")
  unitLabelAr       String                   @default("")
  // The Service Catalogue entry this bookable service was created from ("Add to booking"), so it is never added twice.
  catalogServiceId  String?                  @unique
  catalogService    CatalogService?          @relation(fields: [catalogServiceId], references: [id], onDelete: SetNull)
  minQuantity       Int                      @default(1)
  active            Boolean                  @default(true)
  sortOrder         Int                      @default(0)
  pricesIncludeVat  Boolean? // null = use global TaxSetting
  // Optional customer-facing note about what the price covers, e.g. "Repair only, spare parts not included".
  noteEn            String                   @default("")
  noteAr            String                   @default("")
  // The question above the options, e.g. "What do you need?" (empty = the standard "Choose an option").
  optionLabelEn     String                   @default("")
  optionLabelAr     String                   @default("")
  discountRuleSetId String?
  discountRuleSet   DiscountRuleSet?         @relation(fields: [discountRuleSetId], references: [id])
  prices            ServicePrice[]
  // Choices the customer must pick from (e.g. a gas refill weight), each with its own price per emirate.
  options           ServiceOption[]
  addOns            AddOn[]
  feeOverrides      BookingTypeFeeOverride[]
  orders            Order[]
}

// A service is bookable in a region only if an active row exists here.
model ServicePrice {
  id            String          @id @default(cuid())
  serviceId     String
  service       BookableService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  regionId      String
  region        Region          @relation(fields: [regionId], references: [id], onDelete: Cascade)
  unitPriceFils Int
  active        Boolean         @default(true)
  // true = calculated from the base price and the emirate's price factor (recalculated when those change); a price typed by hand is false and is never overwritten.
  auto          Boolean         @default(false)
  updatedAt     DateTime        @default(now()) @updatedAt

  @@unique([serviceId, regionId])
}

// One choice of a service, e.g. "Quarter kg" / "Half kg" / "1 kg". When a service has active options the customer must
// choose one and the option's price (not the service's own price) is the unit price.
model ServiceOption {
  id        String               @id @default(cuid())
  serviceId String
  service   BookableService      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  nameEn    String
  nameAr    String
  // Optional line under the option explaining what it includes, e.g. "Labour only, parts extra".
  noteEn    String               @default("")
  noteAr    String               @default("")
  sortOrder Int                  @default(0)
  active    Boolean              @default(true)
  prices    ServiceOptionPrice[]

  @@index([serviceId, sortOrder])
}

model ServiceOptionPrice {
  id            String        @id @default(cuid())
  optionId      String
  option        ServiceOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  regionId      String
  region        Region        @relation(fields: [regionId], references: [id], onDelete: Cascade)
  unitPriceFils Int
  active        Boolean       @default(true)
  auto          Boolean       @default(false)
  updatedAt     DateTime      @default(now()) @updatedAt

  @@unique([optionId, regionId])
}

model AddOn {
  id        String          @id @default(cuid())
  serviceId String
  service   BookableService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  nameEn    String
  nameAr    String
  active    Boolean         @default(true)
  prices    AddOnPrice[]
}

model AddOnPrice {
  id        String  @id @default(cuid())
  addOnId   String
  addOn     AddOn   @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  regionId  String
  region    Region  @relation(fields: [regionId], references: [id], onDelete: Cascade)
  priceFils Int
  active    Boolean @default(true)

  @@unique([addOnId, regionId])
}

model BookingType {
  id             String                   @id @default(cuid())
  code           String                   @unique // STANDARD | PRIORITY | EMERGENCY
  nameEn         String
  nameAr         String
  descriptionEn  String?
  descriptionAr  String?
  defaultFeeFils Int                      @default(0)
  hoursStart     String? // "08:00"
  hoursEnd       String? // "22:00"
  sameDayAllowed Boolean                  @default(false)
  active         Boolean                  @default(true)
  sortOrder      Int                      @default(0)
  overrides      BookingTypeFeeOverride[]
  orders         Order[]
}

model BookingTypeFeeOverride {
  id            String           @id @default(cuid())
  bookingTypeId String
  bookingType   BookingType      @relation(fields: [bookingTypeId], references: [id], onDelete: Cascade)
  serviceId     String?
  service       BookableService? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  regionId      String?
  region        Region?          @relation(fields: [regionId], references: [id], onDelete: Cascade)
  feeFils       Int
}

model DiscountRuleSet {
  id       String            @id @default(cuid())
  name     String
  active   Boolean           @default(true)
  startsAt DateTime?
  endsAt   DateTime?
  tiers    DiscountTier[]
  services BookableService[]
}

model DiscountTier {
  id        String          @id @default(cuid())
  ruleSetId String
  ruleSet   DiscountRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  minQty    Int
  maxQty    Int? // null = open-ended
  percent   Float
  startsAt  DateTime?
  endsAt    DateTime?

  @@index([ruleSetId, minQty])
}

// Single-row settings table (id = "default").
model TaxSetting {
  id               String   @id @default("default")
  vatRatePercent   Float    @default(5)
  pricesIncludeVat Boolean  @default(true)
  updatedAt        DateTime @default(now()) @updatedAt
}

// Versioned and immutable: every edit inserts a new row; orders point at the version accepted.
// Pricing rules from the master price list (one row, id "default"): minimum order and the emergency / holiday surcharges.
model PricingRules {
  id               String   @id @default("default")
  minimumOrderFils Int      @default(10000)
  offHoursPercent  Float    @default(50)
  holidayPercent   Float    @default(25)
  normalStart      String   @default("08:00")
  normalEnd        String   @default("18:00")
  holidays         String[]
  updatedAt        DateTime @updatedAt
}

// One row per AI service-finder request (a keyed hash of the visitor's IP, never the IP itself): the per-visitor and daily limits count these.
model AiFinderLog {
  id        String   @id @default(cuid())
  ipHash    String
  // "finder" = a paid AI request; "assistant" = a question to the free services assistant (limits are counted separately)
  kind      String   @default("finder")
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([createdAt])
  @@index([kind, createdAt])
}

model VisitFeePolicy {
  id                  String           @id @default(cuid())
  version             Int              @unique
  amountFils          Int              @default(10000)
  textAr              String
  textEn              String
  consentLabelAr      String
  consentLabelEn      String
  reasons             String[] // e.g. CUSTOMER_REFUSED, UNREACHABLE, CANCELLED_AFTER_DISPATCH
  requiresAdminReview Boolean          @default(true)
  createdById         String?
  createdAt           DateTime         @default(now())
  orders              Order[]
  charges             VisitFeeCharge[]
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // CREATED | CONFIRMED | DISPATCHED | ARRIVED | COMPLETED | CANCELLED_BY_CUSTOMER | CANCELLED_BY_COMPANY | NO_ANSWER
  note      String?
  actorId   String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model VisitFeeCharge {
  id           String         @id @default(cuid())
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  policyId     String
  policy       VisitFeePolicy @relation(fields: [policyId], references: [id])
  reason       String
  evidence     String?
  status       String         @default("PENDING_REVIEW") // PENDING_REVIEW | APPROVED | REJECTED
  reviewedById String?
  reviewNote   String?
  createdAt    DateTime       @default(now())
  reviewedAt   DateTime?
}

model PriceChangeLog {
  id          String   @id @default(cuid())
  entity      String // ServicePrice | DiscountTier | BookingType | TaxSetting | VisitFeePolicy
  entityId    String
  before      Json?
  after       Json?
  changedById String?
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
}

// ===== Roles, permissions & audit =====

model AdminRole {
  id          String     @id @default(cuid())
  key         String     @unique // OWNER | ADMIN | EDITOR | SEO | OPERATIONS | VIEWER
  name        String
  permissions String[]
  employees   Employee[]
}

// Every admin mutation: who, when, what, before/after.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  action    String // e.g. "pricing.price.set"
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
  @@index([createdAt])
}

// ===== Website CMS (block-based pages) =====

// One row per page. Content is bilingual inside the blocks (every text prop is {en, ar}), so a
// page serves both locales; translationGroupId is reserved for splitting locales later.
// draftBlocks/draftSeo are what the editor works on; the live site only ever reads the
// published CmsPageVersion snapshot, so editing never touches what visitors see until Publish.
model CmsPage {
  id                 String           @id @default(cuid())
  slug               String           @unique
  type               String           @default("page") // page | service | area | article | landing
  status             String           @default("DRAFT") // DRAFT | PUBLISHED | SCHEDULED | ARCHIVED
  publishAt          DateTime?
  titleEn            String
  titleAr            String
  showInMenus        Boolean          @default(true)
  // Custom code for this page only (raw HTML). Owner only; applies while the page is published.
  headCode           String           @default("")
  headCodeConsent    String           @default("analytics")
  bodyCode           String           @default("")
  bodyCodeConsent    String           @default("analytics")
  menuParent         String           @default("") // "" = top level of the header | "areas" = inside Areas We Cover | a header MenuItem id
  // Page hierarchy (Website → Structure): organises pages as a tree. It does not change any URL; navigation menus are managed separately.
  parentId           String?
  parent             CmsPage?         @relation("PageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children           CmsPage[]        @relation("PageTree")
  sortOrder          Int              @default(0)
  showInSitemap      Boolean          @default(true)
  translationGroupId String?
  isHomepage         Boolean          @default(false)
  // Set when the page was created from the Service Catalogue ("Create website pages"), so it is never created twice.
  catalogCategoryId  String?          @unique
  catalogServiceId   String?          @unique
  areaId             String?
  area               ServiceArea?     @relation(fields: [areaId], references: [id], onDelete: SetNull)
  showLastUpdated    Boolean          @default(false)
  draftBlocks        Json             @default("[]")
  draftSeo           Json             @default("{}")
  publishedVersionId String?          @unique
  publishedVersion   CmsPageVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id])
  scheduledVersionId String?
  versions           CmsPageVersion[] @relation("PageVersions")
  deletedAt          DateTime?
  createdById        String?
  updatedById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt

  @@index([status, deletedAt])
  @@index([parentId, sortOrder])
}

// A reusable block (Website → Global Blocks). A page that uses it ("Global Sync") shows its current content, so one edit updates
// every page; "Independent copy" copies the content into the page instead and is never linked.
model CmsGlobalBlock {
  id          String   @id @default(cuid())
  name        String
  type        String
  props       Json
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([name])
}

// ===== Annual home maintenance packages (Website → Maintenance Packages) =====

// A set of packages shown together on one page (for example "Commercial maintenance" or "HVAC AMC"), with its own services (the
// comparison rows), texts, terms and call to action. Packages and services with no group belong to the original home packages.
model MaintenanceGroup {
  id         String   @id @default(cuid())
  key        String   @unique
  nameEn     String
  nameAr     String
  headingEn  String   @default("")
  headingAr  String   @default("")
  subtitleEn String   @default("")
  subtitleAr String   @default("")
  noteEn     String   @default("")
  noteAr     String   @default("")
  termsEn    String   @default("")
  termsAr    String   @default("")
  // "subscribe" = Subscribe Now (property details form); "quote" = Request a Quote (business enquiry form)
  ctaMode    String   @default("subscribe")
  // The Smart Package Builder's settings for this group (see maintenance/builder.ts); {} = defaults, builder off.
  builder    Json     @default("{}")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

// A service that packages can include (for example "Preventive AC Maintenance"). The comparison table has one row per service.
model MaintenanceService {
  id               String   @id @default(cuid())
  groupId          String?
  nameEn           String
  nameAr           String
  // Services that are part of another allowance (for example small carpentry inside the handyman hours) can stay out of the table.
  showInComparison Boolean  @default(true)
  // What the package limit on this service counts, so the builder can compare a customer's need with it: "" | "handyman_hours" | "visits"
  metric           String   @default("")
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
}

// A requirement the customer can tick in the Smart Package Builder (for example "AC Duct Vent Cleaning"). It is "included" in a package
// when that package includes the linked service; otherwise it is an extra (priced, or sent as a quotation request when it has no price).
model MaintenanceOption {
  id             String   @id @default(cuid())
  groupId        String?
  category       String   @default("general")
  nameEn         String
  nameAr         String
  serviceId      String?
  extraPrice     Float?
  // Choosing it when the selected package does not include it suggests an upgrade.
  upgradeTrigger Boolean  @default(true)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([groupId, sortOrder])
}

model MaintenancePackage {
  id            String                    @id @default(cuid())
  nameEn        String
  nameAr        String
  descriptionEn String                    @default("")
  descriptionAr String                    @default("")
  suitableEn    String                    @default("")
  suitableAr    String                    @default("")
  groupId       String?
  // The yearly price; empty for a "Custom Quotation" package, which shows priceText instead. pricePrefix is for "Starting from".
  price         Float?
  pricePrefixEn String                    @default("")
  pricePrefixAr String                    @default("")
  priceTextEn   String                    @default("")
  priceTextAr   String                    @default("")
  // [{ en, ar }]: the bullet list shown on the card. Empty = the card lists the included services with their quantities.
  bullets       Json                      @default("[]")
  maxAcUnits    Int?
  badgeEn       String                    @default("")
  badgeAr       String                    @default("")
  highlighted   Boolean                   @default(false)
  active        Boolean                   @default(true)
  sortOrder     Int                       @default(0)
  // [{ serviceId, quantityEn, quantityAr, shortEn?, shortAr? }]: what the package includes and how much of it.
  lines         Json                      @default("[]")
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @default(now()) @updatedAt
  subscriptions MaintenanceSubscription[]

  @@index([active, sortOrder])
}

// The texts around the packages: heading, subtitle, price note and the terms & conditions (one term per line).
model MaintenanceSettings {
  id         String   @id @default("default")
  builder    Json     @default("{}")
  headingEn  String   @default("")
  headingAr  String   @default("")
  subtitleEn String   @default("")
  subtitleAr String   @default("")
  noteEn     String   @default("")
  noteAr     String   @default("")
  termsEn    String   @default("")
  termsAr    String   @default("")
  updatedAt  DateTime @default(now()) @updatedAt
}

// A customer's "Subscribe now" request. The package name and price are copied at the time, so later edits never rewrite history.
model MaintenanceSubscription {
  id               String              @id @default(cuid())
  packageId        String?
  package          MaintenancePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  packageName      String
  packagePrice     Float?
  groupKey         String              @default("")
  // "subscribe" (a household's subscription) or "quote" (a business asking for a quotation)
  kind             String              @default("subscribe")
  company          String              @default("")
  message          String              @default("")
  // Smart Package Builder requests: the customer's extra details, the package the system suggested, and the price worked out by the server.
  whatsapp         String              @default("")
  area             String              @default("")
  address          String              @default("")
  propertySize     Float?
  bathrooms        Int                 @default(0)
  floors           Int                 @default(0)
  suggestedPackage String              @default("")
  subtotal         Float?
  vatAmount        Float?
  total            Float?
  quoteRequested   Boolean             @default(false)
  details          Json                @default("{}")
  name             String
  phone            String
  email            String
  emirate          String
  location         String              @default("")
  propertyType     String              @default("")
  bedrooms         Int                 @default(0)
  acUnits          Int                 @default(0)
  activationDate   DateTime?
  status           String              @default("New") // New | Contacted | Activated | Cancelled
  notes            String              @default("")
  contract         Contract?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @default(now()) @updatedAt

  @@index([status, createdAt])
}

// ---- Maintenance Service Agreements (Contracts & Agreements) ----

// The Terms & Conditions an agreement is built from, in numbered versions. groupKey "" is the default set; a package page can have
// its own. A published version is never edited: a change is a new version, and every agreement keeps the exact text it accepted.
model ContractTerms {
  id            String    @id @default(cuid())
  groupKey      String    @default("")
  version       Int
  status        String    @default("draft") // draft | published | archived
  clauses       Json      @default("[]") // [{ key, titleEn, titleAr, bodyEn, bodyAr }]
  note          String    @default("")
  publishedAt   DateTime?
  createdById   String?
  createdByName String    @default("")
  createdAt     DateTime  @default(now())

  @@unique([groupKey, version])
  @@index([groupKey, status])
}

// One agreement per accepted subscription request. `snapshot` freezes everything the customer agreed to (package, quantities, price,
// property, terms text), so a later change to a package, a price or the terms never alters it.
model Contract {
  id               String                   @id @default(cuid())
  number           String                   @unique // OSTA-AGR-2026-000001
  requestNumber    String                   @unique
  version          Int                      @default(1)
  // PENDING_APPROVAL | DRAFT | CHANGES_REQUESTED | AWAITING_PAYMENT | ACTIVE | CANCELLED | REJECTED  (Expired is worked out from expiryDate)
  status           String                   @default("PENDING_APPROVAL")
  lang             String                   @default("en")
  groupKey         String                   @default("")
  subscriptionId   String?                  @unique
  subscription     MaintenanceSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  customerId       String?
  customer         Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoiceId        String?
  renewedFromId    String?
  snapshot         Json
  termsId          String?
  termsVersion     Int                      @default(1)
  // How and when the customer accepted (recorded before the request is sent).
  acceptedAt       DateTime?
  acceptanceMethod String                   @default("")
  acceptanceIp     String                   @default("")
  acceptanceAgent  String                   @default("")
  approvedTotal    Float?
  approvedAt       DateTime?
  approvedByName   String                   @default("")
  // The secret in the customer's link (agreement page and payment link). Random and unguessable.
  accessToken      String                   @unique
  paymentStatus    String                   @default("unpaid") // unpaid | paid
  paidAt           DateTime?
  paymentMethod    String                   @default("")
  paymentReference String                   @default("")
  paymentNote      String                   @default("")
  activationDate   DateTime?
  expiryDate       DateTime?
  rejectionReason  String                   @default("")
  adminNotes       String                   @default("")
  documents        ContractDocument[]
  events           ContractEvent[]
  addenda          ContractAddendum[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
  @@index([expiryDate])
}

// Settings for the agreements: what the customer is told about paying (until an online gateway is connected, how to pay).
model ContractSettings {
  id                    String   @id @default("default")
  paymentInstructionsEn String   @default("")
  paymentInstructionsAr String   @default("")
  // Renewal reminders (days before expiry the admin list highlights an agreement).
  renewalWindowDays     Int      @default(60)
  updatedAt             DateTime @default(now()) @updatedAt
}

// The PDF files, kept exactly as issued (a draft is never overwritten by the final one).
model ContractDocument {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  kind       String // draft | final | addendum
  addendumId String?
  lang       String   @default("en")
  bytes      Bytes
  size       Int      @default(0)
  sha256     String   @default("")
  createdAt  DateTime @default(now())

  @@index([contractId, kind, createdAt])
}

// The audit trail: every submission, review, approval, payment and amendment.
model ContractEvent {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  kind       String
  actorType  String   @default("system") // customer | admin | system
  actorId    String?
  actorName  String   @default("")
  note       String   @default("")
  data       Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([contractId, createdAt])
}

// A change agreed after the contract was accepted: the original is never edited, an addendum records the change.
model ContractAddendum {
  id           String    @id @default(cuid())
  contractId   String
  contract     Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  number       String    @unique // OSTA-ADD-2026-000001
  titleEn      String    @default("")
  titleAr      String    @default("")
  bodyEn       String    @default("")
  bodyAr       String    @default("")
  amountChange Float     @default(0)
  status       String    @default("issued") // issued | accepted | cancelled
  acceptedAt   DateTime?
  acceptedNote String    @default("")
  issuedByName String    @default("")
  createdAt    DateTime  @default(now())

  @@index([contractId, createdAt])
}

// Immutable snapshot (content + SEO) created on every manual save, publish and restore.
model CmsPageVersion {
  id            String   @id @default(cuid())
  pageId        String
  page          CmsPage  @relation("PageVersions", fields: [pageId], references: [id], onDelete: Cascade)
  version       Int
  kind          String // SAVE | PUBLISH | SCHEDULE | RESTORE
  slug          String
  titleEn       String
  titleAr       String
  blocks        Json
  seo           Json
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  publishedFor  CmsPage? @relation("PublishedVersion")

  @@unique([pageId, version])
}

// Created automatically when a published slug changes; served as a 301 by the public site.
model CmsRedirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  permanent Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ===== Site settings, menus, social (website CMS) =====

// Single row (id = "default"). The one source of truth for brand + contact details
// (name, phone, WhatsApp, email, address) used by header, footer, contact page and structured data.
model SiteSettings {
  id                  String   @id @default("default")
  siteNameEn          String   @default("OSTA Services")
  siteNameAr          String   @default("خدمات أسطا")
  taglineEn           String   @default("Your Comfort. Our Priority.")
  taglineAr           String   @default("راحتك. أولويتنا.")
  descriptionEn       String   @default("")
  descriptionAr       String   @default("")
  logoUrl             String   @default("")
  faviconUrl          String   @default("")
  defaultLocale       String   @default("en")
  allowIndexing       Boolean  @default(true)
  copyrightEn         String   @default("All rights reserved.")
  copyrightAr         String   @default("جميع الحقوق محفوظة.")
  phone               String   @default("")
  whatsapp            String   @default("")
  whatsappMessageEn   String   @default("")
  whatsappMessageAr   String   @default("")
  email               String   @default("")
  addressEn           String   @default("")
  addressAr           String   @default("")
  hoursEn             String   @default("")
  hoursAr             String   @default("")
  mapsUrl             String   @default("")
  businessProfileUrl  String   @default("")
  headerCtaLabelEn    String   @default("Book Now")
  headerCtaLabelAr    String   @default("احجز الآن")
  headerCtaUrl        String   @default("/orders/new")
  footerAreas         Json     @default("[]") // [{ en, ar }]
  // Floating WhatsApp chat pop-up on the public site (needs `whatsapp` above to be set).
  waPopupEnabled      Boolean  @default(true)
  waPopupAutoOpen     Boolean  @default(true)
  waPopupDelaySeconds Int      @default(10)
  waPopupTitleEn      String   @default("Chat with us on WhatsApp")
  waPopupTitleAr      String   @default("تواصل معنا عبر واتساب")
  waPopupTextEn       String   @default("We're available 24/7. Send us a message and we'll reply as soon as we can.")
  waPopupTextAr       String   @default("نحن متواجدون على مدار الساعة طوال أيام الأسبوع. أرسل لنا رسالة وسنرد عليك في أقرب وقت.")
  waPopupButtonEn     String   @default("Start chat")
  waPopupButtonAr     String   @default("ابدأ المحادثة")
  updatedAt           DateTime @default(now()) @updatedAt
}

// Two levels deep (item -> children). menu: "header" | "footer".
model MenuItem {
  id          String     @id @default(cuid())
  menu        String
  parentId    String?
  parent      MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    MenuItem[] @relation("MenuTree")
  labelEn     String
  labelAr     String
  url         String
  sortOrder   Int        @default(0)
  visible     Boolean    @default(true)
  showDesktop Boolean    @default(true)
  showMobile  Boolean    @default(true)
  newTab      Boolean    @default(false)

  @@index([menu, sortOrder])
}

model SocialLink {
  id        String  @id @default(cuid())
  platform  String // facebook | instagram | linkedin | tiktok | youtube | x | whatsapp | custom
  label     String  @default("")
  url       String
  sortOrder Int     @default(0)
  visible   Boolean @default(true)
}

// ===== Media library =====

model MediaFolder {
  id        String       @id @default(cuid())
  name      String
  assets    MediaAsset[]
  createdAt DateTime     @default(now())

  @@unique([name])
}

// Uploaded images are converted to WebP at several widths and stored in the database
// (see MediaVariant), so no external storage account is needed. Public URL: /api/media/<id>.
model MediaAsset {
  id             String         @id @default(cuid())
  folderId       String?
  folder         MediaFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name           String // display / file name, editable
  originalName   String
  originalMime   String
  width          Int
  height         Int
  originalBytes  Int
  altEn          String         @default("")
  altAr          String         @default("")
  title          String         @default("")
  caption        String         @default("")
  variants       MediaVariant[]
  uploadedById   String?
  uploadedByName String?
  createdAt      DateTime       @default(now())

  @@index([folderId, createdAt])
}

model MediaVariant {
  id      String     @id @default(cuid())
  assetId String
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  width   Int
  height  Int
  format  String     @default("webp")
  bytes   Int
  data    Bytes

  @@unique([assetId, width, format])
}

// Where OSTA works: an emirate or a smaller area/city inside one. Phone, address and hours are NOT repeated here:
// they come from SiteSettings so there is a single source of truth (NAP) everywhere.
model ServiceArea {
  id        String            @id @default(cuid())
  regionId  String
  region    Region            @relation(fields: [regionId], references: [id])
  slug      String            @unique
  nameEn    String
  nameAr    String
  kind      String            @default("area") // emirate | area
  latitude  Float?
  longitude Float?
  mapsUrl   String            @default("")
  active    Boolean           @default(true)
  sortOrder Int               @default(0)
  services  BookableService[] @relation("AreaServices")
  pages     CmsPage[]
  branches  Branch[]
  createdAt DateTime          @default(now())
}

// A real office / branch of the company in an emirate (Website → Locations). Only a place that really exists is a Branch: an emirate
// served without an office has no Branch, so no address is ever published for it. The emirate page shows its branch automatically
// (address, map, directions, call / WhatsApp, services, coverage areas, rating, FAQs) and its structured data (LocalBusiness) comes from here.
model Branch {
  id                 String            @id @default(cuid())
  slug               String            @unique // also the fragment of the branch's structured-data @id (#branch-<slug>)
  areaId             String
  area               ServiceArea       @relation(fields: [areaId], references: [id])
  nameEn             String // "Osta Services Ajman"
  nameAr             String
  branchNameEn       String            @default("") // "Ajman Branch"
  branchNameAr       String            @default("")
  streetEn           String            @default("") // street / building line of the address
  streetAr           String            @default("")
  localityEn         String            @default("") // district or city: "Emirates City, Ajman"
  localityAr         String            @default("")
  regionEn           String            @default("") // the emirate written in the address; empty = the page's emirate (Al Ain is in "Abu Dhabi")
  postalCode         String            @default("")
  addressEn          String            @default("") // the full address as shown to visitors
  addressAr          String            @default("")
  latitude           Float
  longitude          Float
  mapsUrl            String            @default("") // Google Maps place link
  mapsEmbedUrl       String            @default("") // empty = built from the coordinates
  appleMapsUrl       String            @default("")
  businessProfileUrl String            @default("") // Google Business Profile
  reviewsUrl         String            @default("")
  phone              String            @default("")
  whatsapp           String            @default("")
  email              String            @default("")
  hours              Json              @default("[]") // [{ days: [0-6], opens: "10:00", closes: "24:00" }]
  images             String[]          @default([])
  ratingValue        Float?
  ratingCount        Int?
  coverage           Json              @default("[]") // [{ nameEn, nameAr }]: areas really served from this branch
  faqs               Json              @default("[]") // [{ question: {en,ar}, answer: {en,ar} }]
  categories         CatalogCategory[] @relation("BranchCategories")
  active             Boolean           @default(true)
  sortOrder          Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt
}

// ===== Forms & leads =====

// Admin-defined form (fields live in `fields` JSON, validated by src/lib/forms/forms.ts). Rendered on the public
// site through the "form" CMS block and submitted to /api/v1/forms/<slug>/submit.
model CmsForm {
  id            String              @id @default(cuid())
  slug          String              @unique
  nameEn        String
  nameAr        String
  fields        Json                @default("[]")
  recipients    String[]            @default([])
  submitLabelEn String              @default("Send")
  submitLabelAr String              @default("إرسال")
  successEn     String              @default("Thank you! We'll be in touch shortly.")
  successAr     String              @default("شكراً لك! سنتواصل معك قريباً.")
  active        Boolean             @default(true)
  submissions   CmsFormSubmission[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @default(now()) @updatedAt
}

// A lead. Contains personal data: only people with leads.view can read it. The visitor's IP is never stored,
// only a keyed hash used for rate limiting.
model CmsFormSubmission {
  id         String   @id @default(cuid())
  formId     String
  form       CmsForm  @relation(fields: [formId], references: [id], onDelete: Cascade)
  data       Json
  status     String   @default("NEW") // NEW | CONTACTED | CLOSED | SPAM
  notes      String   @default("")
  language   String?
  sourcePath String?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([formId, createdAt])
  @@index([ipHash, createdAt])
}

// ===== Integrations & cookie consent (single row, id = "default") =====
// Every ID here is public by nature (it ends up in the page source), so none is a secret.
model IntegrationSettings {
  id                 String   @id @default("default")
  ga4Id              String   @default("")
  gtmId              String   @default("")
  metaPixelId        String   @default("")
  searchConsoleToken String   @default("")
  bingToken          String   @default("")
  requireConsent     Boolean  @default(true)
  consentTextEn      String   @default("")
  consentTextAr      String   @default("")
  privacyUrl         String   @default("")
  // Custom code for every page: raw HTML (scripts, pixels, verification tags). Owner only; see CodeInjection.
  headCode           String   @default("")
  headCodeConsent    String   @default("analytics") // always | analytics | marketing: what the visitor must allow first
  bodyCode           String   @default("")
  bodyCodeConsent    String   @default("analytics")
  updatedAt          DateTime @default(now()) @updatedAt
}

// Plain-text files served by the public site: robots.txt additions, llms.txt, ads.txt and security.txt.
// `ai-crawlers` is not a file: its content is the AI crawler policy ("allow" | "block-training" | "block-all").
model TechnicalFile {
  key       String   @id
  enabled   Boolean  @default(false)
  content   String   @default("")
  updatedAt DateTime @default(now()) @updatedAt
}

// ===== Backlinks (tracking only: nothing here creates links) =====
model Backlink {
  id            String    @id @default(cuid())
  sourceSite    String // domain, e.g. example.com
  sourceUrl     String // the page that links to us
  targetUrl     String // our page being linked to (path like /services or full URL)
  anchorText    String    @default("")
  linkType      String    @default("dofollow") // dofollow | nofollow | sponsored | ugc
  status        String    @default("ACTIVE") // ACTIVE | PENDING | LOST | REJECTED
  campaign      String    @default("")
  notes         String    @default("")
  discoveredAt  DateTime  @default(now())
  lastCheckedAt DateTime?
  lastCheckNote String    @default("")
  createdAt     DateTime  @default(now())

  @@index([status, discoveredAt])
  @@index([targetUrl])
}

// The customer's rating of a finished job (asked before payment). One per order.
model OrderReview {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int // 1-5
  comment    String?
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([rating])
}

// One-time link an admin sends to a customer who forgot their password. Only a hash of the token is stored.
model PasswordResetToken {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([customerId])
}

// ===== Jobs & Workforce =====

enum JobType {
  PERMANENT
  DAILY
}

enum JobStatus {
  DRAFT
  PUBLISHED
  APPLICATIONS_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobApplicationStatus {
  NEW
  UNDER_REVIEW
  SHORTLISTED
  CONTACTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum JobEmirate {
  ABU_DHABI
  DUBAI
  SHARJAH
  AJMAN
  UMM_AL_QUWAIN
  RAS_AL_KHAIMAH
  FUJAIRAH
}

enum JobPropertyType {
  VILLA
  APARTMENT
  FACTORY
  WAREHOUSE
  OFFICE
  COMMERCIAL
  OTHER
}

enum JobMaterialsBy {
  OSTA
  WORKER
  TO_BE_AGREED
}

model JobCategory {
  id        String             @id @default(cuid())
  key       String             @unique // "painting"
  nameEn    String
  nameAr    String
  active    Boolean            @default(true)
  sortOrder Int                @default(0)
  fields    JobCategoryField[]
  jobs      Job[]
}

// Configurable per-category fields (for example painting -> paint finish).
model JobCategoryField {
  id         String      @id @default(cuid())
  categoryId String
  category   JobCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key        String // "paintFinish"
  labelEn    String
  labelAr    String
  inputType  String // select | text | number | boolean
  options    Json? // [{ value, labelEn, labelAr }]
  appliesTo  JobType[]
  required   Boolean     @default(false)
  showInAd   Boolean     @default(true)
  sortOrder  Int         @default(0)

  @@unique([categoryId, key])
}

model Job {
  id                  String             @id @default(cuid())
  number              Int                @unique @default(autoincrement())
  // Generated on the first publish ({category}-{emirate}-{number}) and never changed afterwards.
  slug                String?            @unique
  type                JobType
  status              JobStatus          @default(DRAFT)
  categoryId          String
  category            JobCategory        @relation(fields: [categoryId], references: [id])
  titleEn             String?
  titleAr             String?
  descriptionEn       String? // sanitized HTML
  descriptionAr       String?
  workersRequired     Int                @default(1)
  emirate             JobEmirate
  area                String?
  propertyType        JobPropertyType?
  startDate           DateTime?
  applicationDeadline DateTime?
  monthlySalaryMin    Decimal?           @db.Decimal(10, 2)
  monthlySalaryMax    Decimal?           @db.Decimal(10, 2)
  workingDaysPerWeek  Int?
  dailyWage           Decimal?           @db.Decimal(10, 2) // null = "to be agreed"
  workingDays         Int?
  // The admin explicitly chose "to be agreed" for the wage/salary (an empty wage with this off simply shows no wage line).
  wageToBeAgreed      Boolean            @default(false)
  dailyHours          String?
  materialsBy         JobMaterialsBy?
  requirementsEn      String?
  requirementsAr      String?
  customFields        Json?
  orderId             String?
  order               Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  publishedAt         DateTime?
  completedAt         DateTime?
  createdById         String
  createdBy           Employee           @relation("JobCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  applications        JobApplication[]
  statusHistory       JobStatusHistory[]
  notifications       JobNotification[]

  @@index([status, type, emirate])
  @@index([categoryId])
}

model JobStatusHistory {
  id        String     @id @default(cuid())
  jobId     String
  job       Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  from      JobStatus?
  to        JobStatus
  note      String?
  byUserId  String
  byName    String?
  createdAt DateTime   @default(now())

  @@index([jobId, createdAt])
}

// One per person, found by phone number.
model JobApplicant {
  id              String           @id @default(cuid())
  fullName        String
  phone           String           @unique // E.164
  whatsapp        String? // E.164
  preferredLang   String // ar | en | other text
  emirate         JobEmirate?
  area            String?
  skills          String[]
  otherSkills     String?
  experienceYears Int?
  employeeId      String? // set when converted to an Employee record
  anonymizedAt    DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  applications    JobApplication[]
}

model JobApplication {
  id             String                @id @default(cuid())
  seq            Int                   @unique @default(autoincrement())
  code           String?               @unique // APP-000125
  jobId          String
  job            Job                   @relation(fields: [jobId], references: [id])
  applicantId    String
  applicant      JobApplicant          @relation(fields: [applicantId], references: [id])
  status         JobApplicationStatus  @default(NEW)
  notes          String?
  snapshot       Json
  consentAt      DateTime
  consentIpHash  String?
  idempotencyKey String?               @unique
  isRead         Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  photos         JobApplicationPhoto[]
  internalNotes  JobApplicationNote[]
  contactLogs    JobContactLog[]

  @@unique([jobId, applicantId])
  @@index([status, createdAt])
  @@index([applicantId])
}

// Photo metadata. The bytes live in JobPhotoData (never selected by list queries) and are served only through an
// authenticated admin route. storageKey is the private key; swap JobPhotoData for S3/Blob without touching callers.
model JobApplicationPhoto {
  id            String         @id @default(cuid())
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  storageKey    String         @unique
  mimeType      String
  sizeBytes     Int
  width         Int?
  height        Int?
  sortOrder     Int
  createdAt     DateTime       @default(now())
  data          JobPhotoData?

  @@index([applicationId])
}

model JobPhotoData {
  photoId String              @id
  photo   JobApplicationPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  data    Bytes
  thumb   Bytes
}

// A photo uploaded before the form is submitted. Bound to a short-lived signed token; orphans are cleaned by the cron.
model JobUploadTemp {
  id        String    @id @default(cuid())
  jobId     String
  ipHash    String
  mimeType  String
  sizeBytes Int
  width     Int?
  height    Int?
  data      Bytes
  thumb     Bytes
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([ipHash, createdAt])
}

model JobApplicationNote {
  id            String         @id @default(cuid())
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  body          String
  byUserId      String
  byName        String?
  createdAt     DateTime       @default(now())
}

model JobContactLog {
  id            String         @id @default(cuid())
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  channel       String // call | whatsapp
  outcome       String // reached | no_answer | interested | not_interested | other
  note          String?
  byUserId      String
  byName        String?
  createdAt     DateTime       @default(now())
}

model JobNotification {
  id            String    @id @default(cuid())
  type          String // new_application | deadline_soon | start_soon | expected_end
  jobId         String?
  job           Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicationId String?
  message       String
  // Makes reminders idempotent: the same reminder is never created twice.
  dedupeKey     String?   @unique
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([readAt, createdAt])
}

model JobSettings {
  id               String   @id @default("default")
  minPhotos        Int      @default(1)
  maxPhotos        Int      @default(5)
  maxFileMb        Int      @default(8)
  notifyEmail      Boolean  @default(false)
  notifyRecipients String[]
  emailDigest      Boolean  @default(false)
  retentionMonths  Int      @default(12)
  // [{ key, labelEn, labelAr, active }]
  skills           Json     @default("[]")
  // Area suggestions for the job form: ["Al Nuaimiya", ...]
  areas            Json     @default("[]")
  updatedAt        DateTime @default(now()) @updatedAt
}

// Service Catalogue (the master list of service categories and the services in them). Bilingual, SEO per item, and a service
// can belong to several categories. Admin-managed; independent of the bookable services/pricing until they are linked.
model CatalogCategory {
  id                 String                   @id @default(cuid())
  code               String?
  slug               String                   @unique
  nameEn             String
  nameAr             String
  shortDescriptionEn String                   @default("")
  shortDescriptionAr String                   @default("")
  descriptionEn      String                   @default("")
  descriptionAr      String                   @default("")
  iconName           String?
  imageUrl           String?
  sortOrder          Int                      @default(0)
  active             Boolean                  @default(false)
  seoTitleEn         String?
  seoTitleAr         String?
  seoDescriptionEn   String?
  seoDescriptionAr   String?
  seoKeywordsEn      String?
  seoKeywordsAr      String?
  canonicalUrl       String?
  services           CatalogCategoryService[]
  branches           Branch[]                 @relation("BranchCategories")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @default(now()) @updatedAt

  @@index([sortOrder])
}

model CatalogService {
  id                 String                   @id @default(cuid())
  slug               String                   @unique
  nameEn             String
  nameAr             String
  shortDescriptionEn String                   @default("")
  shortDescriptionAr String                   @default("")
  descriptionEn      String                   @default("")
  descriptionAr      String                   @default("")
  // A sub-heading inside its category (for example "A. Elevator Services").
  groupEn            String?
  groupAr            String?
  iconName           String?
  imageUrl           String?
  gallery            Json                     @default("[]")
  active             Boolean                  @default(false)
  seoTitleEn         String?
  seoTitleAr         String?
  seoDescriptionEn   String?
  seoDescriptionAr   String?
  seoKeywordsEn      String?
  seoKeywordsAr      String?
  canonicalUrl       String?
  categories         CatalogCategoryService[]
  bookable           BookableService?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @default(now()) @updatedAt
}

model CatalogCategoryService {
  categoryId String
  category   CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  serviceId  String
  service    CatalogService  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  sortOrder  Int             @default(0)

  @@id([categoryId, serviceId])
  @@index([categoryId, sortOrder])
  @@index([serviceId])
}

// Append-only payment history of an invoice: every creation, payment received, reversal. Rows are never edited or
// deleted on their own (only with the invoice), so a payment date can't change without leaving a trace.
model InvoicePayment {
  id                  String    @id @default(cuid())
  invoiceId           String
  invoice             Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // "Invoice Created" | "Payment Received" | "Payment Reversed"
  kind                String
  previousStatus      String
  newStatus           String
  // Money received by this event (0 for creation/reversal).
  amount              Float     @default(0)
  paidAfter           Float     @default(0)
  method              String?
  paymentDate         DateTime?
  previousPaymentDate DateTime?
  note                String?
  changedById         String
  changedBy           Employee  @relation("InvoicePaymentBy", fields: [changedById], references: [id])
  createdAt           DateTime  @default(now())

  @@index([invoiceId, createdAt])
}

// A purchase of parts / materials made for a customer's job (not a general company expense). It is linked to the customer and
// the service order and costed on that order. Once approved it has exactly ONE Expense row (expenseId) carrying its total, so
// the financial reports see the money once; the purchase itself only adds the detail (items, supplier, order, margin).
model CustomerPurchase {
  id                 String                 @id @default(cuid())
  number             String                 @unique // CMP-2026-000001
  status             String                 @default("Pending") // Pending | Approved | Rejected
  purchaseDate       DateTime
  customerId         String
  customer           Customer               @relation(fields: [customerId], references: [id])
  orderId            String?
  order              Order?                 @relation(fields: [orderId], references: [id])
  teamId             String?
  teamName           String?
  technicianId       String?
  technicianName     String?
  emirate            String?
  supplierName       String?
  supplierInvoiceNo  String?
  paymentMethod      String
  creditCardId       String?
  notes              String?
  supplierInvoiceUrl String?
  total              Float
  expenseId          String?                @unique
  expense            Expense?               @relation(fields: [expenseId], references: [id])
  createdById        String
  createdBy          Employee               @relation("CustomerPurchaseCreatedBy", fields: [createdById], references: [id])
  approvedById       String?
  approvedAt         DateTime?
  rejectionReason    String?
  items              CustomerPurchaseItem[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([purchaseDate])
}

model CustomerPurchaseItem {
  id                String           @id @default(cuid())
  purchaseId        String
  purchase          CustomerPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  qty               Float
  unitPrice         Float
  total             Float
  supplier          String?
  supplierInvoiceNo String?
}

// ---- Self-Service Quotations (the ducted / concealed / semi-central AC installation calculator) ----

// Every price, package, optional service and text of the calculator, in one document edited in the dashboard (see lib/acquote/config.ts).
model AcQuoteSettings {
  id            String   @id @default("default")
  config        Json     @default("{}")
  updatedByName String   @default("")
  updatedAt     DateTime @default(now()) @updatedAt
}

// A quotation a customer built on the website. `snapshot` holds the lines and totals exactly as they were worked out, so a later change
// to the price list never alters it; changing it makes a new version.
model SelfQuote {
  id              String             @id @default(cuid())
  number          String             @unique // OSTA-DQ-2026-000001 (ducted AC) / OSTA-DW-2026-000001 (ductwork)
  // Which calculator built it: "ac-install" (ducted / concealed AC installation) or "ductwork" (HVAC duct fabrication & installation).
  kind            String             @default("ac-install")
  // What the customer asked for when they sent it: "book" | "inspection" | "final" | "inquiry".
  requestType     String             @default("")
  version         Int                @default(1)
  // Draft | Generated | Submitted | Under Review | Site Inspection Required | Revised | Sent | Accepted | Rejected | Converted to Order  (Expired is worked out from expiresAt)
  status          String             @default("Generated")
  lang            String             @default("en")
  customerName    String
  phone           String
  whatsapp        String             @default("")
  email           String             @default("")
  contactMethod   String             @default("")
  preferredDate   DateTime?
  emirate         String
  location        String             @default("")
  propertyType    String             @default("")
  project         Json               @default("{}")
  snapshot        Json
  subtotal        Float              @default(0)
  vatAmount       Float              @default(0)
  total           Float              @default(0)
  rfq             Boolean            @default(false)
  // The secret in the customer's link to their quotation. Random and unguessable.
  accessToken     String             @unique
  expiresAt       DateTime
  customerId      String?
  customer        Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId         String?            @unique
  bookRequested   Boolean            @default(false)
  submittedAt     DateTime?
  sentAt          DateTime?
  decidedAt       DateTime?
  rejectionReason String             @default("")
  internalNotes   String             @default("")
  lastEditedBy    String             @default("")
  versions        SelfQuoteVersion[]
  events          SelfQuoteEvent[]
  files           SelfQuoteFile[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([phone])
  @@index([customerId])
  @@index([kind, createdAt])
}

// Every earlier version of a quotation, kept as it was issued.
model SelfQuoteVersion {
  id        String    @id @default(cuid())
  quoteId   String
  quote     SelfQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  version   Int
  snapshot  Json
  total     Float     @default(0)
  reason    String    @default("")
  byType    String    @default("customer") // customer | admin
  byName    String    @default("")
  createdAt DateTime  @default(now())

  @@unique([quoteId, version])
}

model SelfQuoteEvent {
  id        String    @id @default(cuid())
  quoteId   String
  quote     SelfQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  kind      String
  actorType String    @default("system") // customer | admin | system
  actorId   String?
  actorName String    @default("")
  note      String    @default("")
  data      Json      @default("{}")
  createdAt DateTime  @default(now())

  @@index([quoteId, createdAt])
}

// Drawings, BOQ and site photos sent with a quotation. Stored privately in the database (never public); a file uploaded before the
// quotation exists waits under its uploadKey and is attached when the quotation is created.
model SelfQuoteFile {
  id        String     @id @default(cuid())
  quoteId   String?
  quote     SelfQuote? @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  uploadKey String
  // "drawing" | "boq" | "" (ductwork quotations keep the two apart)
  category  String     @default("")
  ipHash    String     @default("")
  name      String
  mime      String
  size      Int
  bytes     Bytes
  createdAt DateTime   @default(now())

  @@index([uploadKey])
  @@index([quoteId])
}


// ---- Calendar & Scheduling ----
// A team's own working schedule. A team with no row (or active = false) is not managed by the calendar: its orders behave exactly as before.
model TeamSchedule {
  teamId        String   @id
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  active        Boolean  @default(true)
  regionIds     String[] @default([]) // the emirates (Region ids) the team covers
  serviceIds    String[] @default([]) // the bookable services it can do (empty = every service)
  workDays      Int[]    @default([1, 2, 3, 4, 5, 6]) // 0 = Sunday ... 6 = Saturday
  startTime     String   @default("08:00") // UAE time
  endTime       String   @default("18:00")
  breaks        Json     @default("[]") // [{ "start": "13:00", "end": "14:00" }]
  travelMinutes Int      @default(30) // gap kept after each booking
  maxPerDay     Int      @default(0) // 0 = no limit
  updatedAt     DateTime @updatedAt
}

// Global calendar rules (advance days, minimum notice, same-day, default duration, holidays, closures, service durations).
model CalendarSettings {
  id            String   @id @default("default")
  config        Json
  updatedByName String   @default("")
  updatedAt     DateTime @updatedAt
}

// One busy period of one team: a booking (linked to its order) or a block (leave, maintenance, ...). All times are UTC instants; the
// calendar shows them in UAE time. busyUntil = endsAt + the team's travel time. The database refuses two active, non-overridden periods
// of the same team that overlap (see prisma/calendar-constraints.sql), so no channel can double-book a team.
model CalendarEntry {
  id            String          @id @default(cuid())
  kind          String          @default("BOOKING") // BOOKING | BLOCK | HOLD (a customer's chosen time, kept for a few minutes while they finish booking)
  teamId        String
  team          Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  orderId       String?         @unique
  order         Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  startsAt      DateTime
  endsAt        DateTime
  busyUntil     DateTime
  state         String          @default("ACTIVE") // ACTIVE | CANCELLED
  override      Boolean         @default(false) // booked past a conflict by an authorised admin (outside the database protection)
  reason        String          @default("")
  serviceId     String?
  regionId      String?
  area          String          @default("")
  quantity      Int?
  notes         String          @default("")
  createdByName String          @default("")
  // A HOLD stops counting the moment it expires; holdKey is the secret the customer's booking quotes to claim it.
  expiresAt        DateTime?
  holdKey          String?         @unique
  heldByCustomerId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  events        CalendarEvent[]

  @@index([heldByCustomerId])
  @@index([teamId, startsAt])
  @@index([startsAt])
}

// The full history of a booking: created, moved, reassigned, cancelled, completed...
model CalendarEvent {
  id        String        @id @default(cuid())
  entryId   String
  entry     CalendarEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  action    String
  actorName String        @default("")
  detail    String        @default("")
  createdAt DateTime      @default(now())

  @@index([entryId, createdAt])
}
